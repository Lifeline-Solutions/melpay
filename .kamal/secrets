# Kamal secrets file (SAFE FOR GIT, no raw literals). Provide credentials via environment before deploy.
# Export in shell or use a secret manager fetch prior to running `kamal`.
# Example:
#   export KAMAL_REGISTRY_PASSWORD="dckr_pat_..."   # Docker PAT
#   export RAILS_MASTER_KEY="$(cat config/master.key)"
#   export SECRET_KEY_BASE="$(ruby -rsecurerandom -e 'puts SecureRandom.hex(64)')"
#   export POSTGRES_PASSWORD="<secure_db_password>"

KAMAL_REGISTRY_PASSWORD=${KAMAL_REGISTRY_PASSWORD:?Missing KAMAL_REGISTRY_PASSWORD}
RAILS_MASTER_KEY=${RAILS_MASTER_KEY:?Missing RAILS_MASTER_KEY}
SECRET_KEY_BASE=${SECRET_KEY_BASE:?Missing SECRET_KEY_BASE}
POSTGRES_PASSWORD=${POSTGRES_PASSWORD:?Missing POSTGRES_PASSWORD}
