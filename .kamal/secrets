# .kamal/secrets
# Automatically load from local .env file if it exists
if [ -f .env ]; then
  set -a
  source .env
  set +a
fi

# --- RAILS MASTER KEY --------------------------------------------------------
# Rails reads ENV["RAILS_MASTER_KEY"] IN PREFERENCE TO any key file on disk.
# Because config/credentials/production.yml.enc exists, production Rails opens
# THAT file — so the key in this variable must be the one that unlocks it.
#
# That is config/credentials/production.key, not config/master.key.
# Feeding it master.key is what caused "Missing secret_key_base".
RAILS_MASTER_KEY=$(cat config/credentials/production.key)
# ---------------------------------------------------------------------------

# GitHub Container Registry. Create a token at github.com/settings/tokens
# with the write:packages scope, then: export KAMAL_REGISTRY_PASSWORD=ghp_...

KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
# Postgres. Generate once with `openssl rand -hex 24`, then keep the SAME
# value exported for every deploy — changing it will not change the password
# already baked into the database volume.
POSTGRES_PASSWORD=$POSTGRES_PASSWORD

# Resend. Used as the SMTP password (username is the literal "resend").
# Already present in .env, which is sourced at the top of this file.


