<div>
<section class="mx-auto md:min-w-md">
  <div class="flex flex-col items-center justify-center px-6 py-8 mx-auto md:h-screen lg:py-0">
    <%= form_with url: check_otp_path, local: true, html: { id: 'otp-form' } do |f| %>
      <div class="w-full bg-white rounded-lg shadow dark:border md:mt-0 sm:max-w-md xl:p-0 dark:bg-gray-800 dark:border-gray-700">
        <div class="p-6 space-y-4 md:space-y-6 sm:p-8">
          <h1 class="text-md font-bold leading-tight tracking-tight">
            <% if flash[:notice] %>
              <p class="notice"><%= flash[:notice] %></p>
            <% end %>
            <% if flash[:alert] %>
              <p class="alert"><%= flash[:alert] %></p>
            <% end %>
          </h1>
          <h1 class="text-xl font-bold leading-tight tracking-tight text-gray-900 md:text-2xl dark:text-white">
            Please enter the 6-digit verification code sent to your email.
          </h1>
          <div class="space-y-4 md:space-y-6">
            <div class="flex gap-2 justify-center">
              <% 6.times do |i| %>
                <%= text_field_tag "otp_digit_#{i}", nil, autocomplete: (i == 0 ? 'one-time-code' : nil), inputmode: 'numeric', pattern: '\\d', maxlength: 1, placeholder: '•', class: "border border-gray-300 rounded-lg focus:ring-primary-600 focus:border-primary-600 w-10 h-12 text-center mx-1 text-xl dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500 otp-digit", required: true, id: "otp_digit_#{i}" %>
              <% end %>
              <%= hidden_field_tag :otp_code, '', id: 'otp_code' %>
            </div>
            <%= f.submit 'VERIFY', class: 'h-12  border-2 hover:border-[#31adaf] hover:text-[#31adaf] p-3 rounded-lg font-bold w-full mb-4' %>

            <p class="text-sm font-light gap-4">
              Didn't receive a code?
              <span>
                <%= link_to 'Resend code', send_otp_two_factor_path, method: :get, class: "font-medium text-primary-600 hover:underline dark:text-primary-500" %>
              </span>
            </p>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</section>
</div>

<script>
document.addEventListener('turbo:load', function() {
  const inputs = Array.from(document.querySelectorAll('.otp-digit'));
  const hiddenOtp = document.getElementById('otp_code');
  // Auto-advance and backspace
  inputs.forEach((input, idx) => {
    input.addEventListener('input', function(e) {
      if (this.value.length === 1 && idx < inputs.length - 1) {
        inputs[idx + 1].focus();
      }
      updateHiddenOtp();
    });
    input.addEventListener('keydown', function(e) {
      if (e.key === 'Backspace' && this.value === '' && idx > 0) {
        inputs[idx - 1].focus();
      }
    });
  });
  function updateHiddenOtp() {
    hiddenOtp.value = inputs.map(i => i.value).join('');
  }
  // On form submit, ensure hidden field is updated
  document.getElementById('otp-form').addEventListener('submit', function(e) {
    updateHiddenOtp();
  });
});
</script>
