
<div>
<section class="mx-auto md:min-w-md">
  <div class="flex flex-col items-center justify-center px-6 py-8 mx-auto md:h-screen lg:py-0">
    <%= form_with url: check_otp_path, local: true do |f| %>
      <div class="w-full bg-white rounded-lg shadow dark:border md:mt-0 sm:max-w-md xl:p-0 dark:bg-gray-800 dark:border-gray-700">
        <div class="p-6 space-y-4 md:space-y-6 sm:p-8">
          <h1 class="text-md font-bold leading-tight tracking-tight">
            <% if flash[:notice] %>
              <p class="notice"><%= flash[:notice] %></p>
            <% end %>
            <% if flash[:alert] %>
              <p class="alert"><%= flash[:alert] %></p>
            <% end %>
          </h1>
          <h1 class="text-xl font-bold leading-tight tracking-tight text-gray-900 md:text-2xl dark:text-white">
            Please enter the 6-digit verification code sent to your email.
          </h1>
          <form class="space-y-4 md:space-y-6" action="#">
            <div>
              <%= label_tag :otp_code, 'Verification code', class: "block mb-2 text-sm font-medium text-gray-900 dark:text-white"%>
              <%= text_field_tag :otp_code, nil, autocomplete: 'one-time-code', inputmode: 'numeric', pattern: '\\d{6}', maxlength: 6, placeholder: '123456', class: "border border-gray-300 rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500", required: true  %>
            </div>
            <%= f.submit 'VERIFY', class: "w-full border border-gray-900 dark:border-gray-100 bg-primary-600 hover:bg-primary-700 focus:ring-4 focus:outline-none focus:ring-primary-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:bg-primary-600 dark:hover:bg-primary-700 dark:focus:ring-primary-800" %>

            <p class="text-sm font-light gap-4">
              Didn't receive a code?
              <span>
                <%= link_to 'Resend code', send_otp_two_factor_path, method: :get, class: "font-medium text-primary-600 hover:underline dark:text-primary-500" %>
              </span>
            </p>
          </form>
        </div>
      </div>
    <% end %>
  </div>
</section>
</div>