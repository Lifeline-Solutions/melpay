<% provide(:title, "Set Your Password") %>

<%= render layout: "devise/shared/auth_shell",
           locals: { heading: "One last step before you're in.",
                     subheading: "Set a password to activate your account and start managing transactions securely." } do %>

  <h2 class="font-display text-2xl font-bold text-ink"><%= t "devise.invitations.edit.header" %></h2>
  <p class="mt-1 text-sm text-ink-2 mb-8">Choose a password to finish setting up your account.</p>

  <%= form_for(resource, as: resource_name, url: invitation_path(resource_name), html: { method: :put, class: "space-y-5" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= f.hidden_field :invitation_token, readonly: true %>

    <% if f.object.class.require_password_on_accepting %>
      <div>
        <%= f.label :password, "Password", class: "mb-2 block text-sm font-semibold text-ink" %>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password", required: true,
                             class: "block h-12 w-full rounded-lg border border-line bg-white px-4 text-ink placeholder:text-ink-2/50 focus:border-teal-deep focus:outline-none focus:ring-2 focus:ring-teal/30" %>
        <% if @minimum_password_length %>
          <p class="mt-1.5 text-xs text-ink-2"><%= @minimum_password_length %> characters minimum</p>
        <% end %>
      </div>

      <div>
        <%= f.label :password_confirmation, "Confirm password", class: "mb-2 block text-sm font-semibold text-ink" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true,
                             class: "block h-12 w-full rounded-lg border border-line bg-white px-4 text-ink placeholder:text-ink-2/50 focus:border-teal-deep focus:outline-none focus:ring-2 focus:ring-teal/30" %>
      </div>
    <% end %>

    <%= f.submit t("devise.invitations.edit.submit_button"), class: "h-12 w-full cursor-pointer rounded-lg bg-ink font-semibold text-white hover:bg-teal-deep focus:outline-none focus-visible:ring-2 focus-visible:ring-teal focus-visible:ring-offset-2" %>
  <% end %>

  <div class="mt-8 space-y-2 border-t border-line pt-6 text-sm">
    <%= render "devise/shared/restricted_links" %>
  </div>
<% end %>
