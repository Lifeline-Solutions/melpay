<% provide(:title, "Invite User") %>
<% content_for :head do %>
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=Public+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<% end %>
<%
  available_roles = if current_user.has_role?(:super_admin)
                      Role.all.pluck(:name)
                    elsif current_user.has_role?(:admin)
                      Role.where.not(name: "super_admin").pluck(:name)
                    else
                      ["account_manager"]
                    end

  available_clients = if current_user.has_role?(:super_admin)
                        Client.where(kyc_status: "approved")
                      else
                        Client.where(id: current_user.client_id, kyc_status: "approved")
                      end

  is_admin     = current_user.has_role?(:admin)
  admin_client = current_user.client if is_admin
%>

<div class="min-h-screen bg-white p-4 font-sans text-ink antialiased sm:ml-64 sm:p-8">
  <div class="mx-auto max-w-xl py-6">
    <h1 class="font-display text-3xl font-bold tracking-tight"><%= t "devise.invitations.new.header" %></h1>
    <p class="mt-1 text-ink-2">Send an invitation to add a new team member.</p>

    <%= render "devise/shared/flash" %>

    <%= form_for(resource, as: resource_name, url: invitation_path(resource_name), html: { method: :post, class: "mt-8 space-y-5 rounded-2xl border border-line p-6 sm:p-8" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <% resource.class.invite_key_fields.each do |field| -%>
        <div>
          <%= f.label field, class: "mb-2 block text-sm font-semibold text-ink" %>
          <%= f.text_field field, required: true, class: "block h-12 w-full rounded-lg border border-line bg-white px-4 text-ink placeholder:text-ink-2/50 focus:border-teal-deep focus:outline-none focus:ring-2 focus:ring-teal/30" %>
        </div>
      <% end -%>

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <%= f.label :first_name, "First name*", class: "mb-2 block text-sm font-semibold text-ink" %>
          <%= f.text_field :first_name, required: true, autocomplete: "off", class: "block h-12 w-full rounded-lg border border-line bg-white px-4 text-ink placeholder:text-ink-2/50 focus:border-teal-deep focus:outline-none focus:ring-2 focus:ring-teal/30" %>
        </div>
        <div>
          <%= f.label :last_name, "Last name*", class: "mb-2 block text-sm font-semibold text-ink" %>
          <%= f.text_field :last_name, required: true, autocomplete: "off", class: "block h-12 w-full rounded-lg border border-line bg-white px-4 text-ink placeholder:text-ink-2/50 focus:border-teal-deep focus:outline-none focus:ring-2 focus:ring-teal/30" %>
        </div>
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <%= label_tag :role, "Role*", class: "mb-2 block text-sm font-semibold text-ink" %>
          <%= select_tag :role, options_for_select(available_roles),
                         prompt: "Select role", required: true, class: "block h-12 w-full rounded-lg border border-line bg-white px-3 text-ink focus:border-teal-deep focus:outline-none focus:ring-2 focus:ring-teal/30" %>
        </div>

        <div>
          <%= f.label :client_id, "Client*", class: "mb-2 block text-sm font-semibold text-ink" %>
          <% if is_admin && admin_client %>
            <%= f.hidden_field :client_id, value: admin_client.id %>
            <p class="flex h-12 items-center truncate rounded-lg border border-line bg-mist px-4 text-ink"><%= admin_client.name %></p>
          <% else %>
            <%= f.select :client_id, options_from_collection_for_select(available_clients, :id, :name),
                         { prompt: "Select client" },
                         required: true, class: "block h-12 w-full rounded-lg border border-line bg-white px-3 text-ink focus:border-teal-deep focus:outline-none focus:ring-2 focus:ring-teal/30" %>
          <% end %>
        </div>
      </div>

      <% if is_admin && admin_client %>
        <p class="text-xs text-ink-2">Admins can only invite users to their own client.</p>
      <% end %>

      <%= f.submit t("devise.invitations.new.submit_button"), class: "h-12 w-full cursor-pointer rounded-lg bg-ink font-semibold text-white hover:bg-teal-deep focus:outline-none focus-visible:ring-2 focus-visible:ring-teal focus-visible:ring-offset-2" %>
    <% end %>
  </div>
</div>
