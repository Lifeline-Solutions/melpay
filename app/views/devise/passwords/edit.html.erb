<% provide(:title, "Change Password") %>

<%= render layout: "devise/shared/auth_shell",
           locals: { heading: "Choose a new password.",
                     subheading: "Pick something you haven't used before. You'll sign in with it from now on." } do %>

  <h2 class="font-display text-2xl font-bold text-ink">Change your password</h2>
  <p class="mt-1 text-sm text-ink-2 mb-8">Enter your new password twice.</p>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "space-y-5" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= f.hidden_field :reset_password_token %>

    <div>
      <%= f.label :password, "New password", class: "mb-2 block text-sm font-semibold text-ink" %>
      <%= f.password_field :password, autofocus: true, autocomplete: "new-password", required: true,
                           class: "block h-12 w-full rounded-lg border border-line bg-white px-4 text-ink placeholder:text-ink-2/50 focus:border-teal-deep focus:outline-none focus:ring-2 focus:ring-teal/30" %>
      <% if @minimum_password_length %>
        <p class="mt-1.5 text-xs text-ink-2"><%= @minimum_password_length %> characters minimum</p>
      <% end %>
    </div>

    <div>
      <%= f.label :password_confirmation, "Confirm new password", class: "mb-2 block text-sm font-semibold text-ink" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true,
                           class: "block h-12 w-full rounded-lg border border-line bg-white px-4 text-ink placeholder:text-ink-2/50 focus:border-teal-deep focus:outline-none focus:ring-2 focus:ring-teal/30" %>
    </div>

    <%= f.submit "Change my password", class: "h-12 w-full cursor-pointer rounded-lg bg-ink font-semibold text-white hover:bg-teal-deep focus:outline-none focus-visible:ring-2 focus-visible:ring-teal focus-visible:ring-offset-2" %>
  <% end %>

  <div class="mt-8 space-y-2 border-t border-line pt-6 text-sm">
    <%= render "devise/shared/restricted_links" %>
  </div>
<% end %>
