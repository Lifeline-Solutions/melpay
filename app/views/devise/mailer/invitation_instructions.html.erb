<p style="margin:0 0 16px;font-size:20px;line-height:28px;font-weight:700;color:#14262F;"><%= t("devise.mailer.invitation_instructions.hello", first_name: @resource.first_name, last_name: @resource.last_name) %></p>

<p style="margin:0 0 16px;font-size:15px;line-height:24px;color:#3B5260;"><%= t("devise.mailer.invitation_instructions.someone_invited_you",
         inviter_first_name: @resource.invited_by&.first_name || "Someone",
         inviter_last_name: @resource.invited_by&.last_name || "",
         url: root_url) %></p>

<p style="margin:24px 0;">
  <%= link_to t("devise.mailer.invitation_instructions.accept"), accept_invitation_url(@resource, invitation_token: @token), style: "display:inline-block;background:#1D7C79;color:#ffffff;text-decoration:none;font-weight:600;font-size:15px;padding:12px 24px;border-radius:8px;" %>
</p>

<% if @resource.invitation_due_at %>
  <p style="margin:0 0 16px;font-size:15px;line-height:24px;color:#3B5260;"><%= t("devise.mailer.invitation_instructions.accept_until", due_date: l(@resource.invitation_due_at, format: :'devise.mailer.invitation_instructions.accept_until_format')) %></p>
<% end %>

<% if @resource.user_pass.present? %>
  <div style="margin:0 0 24px;padding:16px;border:1px solid #D5E3E1;border-radius:8px;background:#EAF3F2;">
    <p style="margin:0 0 4px;font-size:13px;color:#3B5260;">Your secret word. Never share it with anyone.</p>
    <p style="margin:0;font-size:20px;font-weight:700;letter-spacing:1px;color:#14262F;"><%= @resource.user_pass %></p>
  </div>
<% end %>

<p style="margin:0;font-size:15px;line-height:24px;color:#3B5260;">Regards,</p>
<p style="margin:0 0 16px;font-size:15px;line-height:24px;color:#3B5260;font-weight:600;color:#14262F;"><%= [@resource.invited_by&.first_name, @resource.invited_by&.last_name].compact.join(" ").presence || "The MAL Payments team" %></p>

<p style="margin:0;font-size:13px;line-height:20px;color:#3B5260;"><%= t("devise.mailer.invitation_instructions.ignore") %></p>
