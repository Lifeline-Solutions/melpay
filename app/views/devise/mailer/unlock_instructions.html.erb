<p style="margin:0 0 16px;font-size:20px;line-height:28px;font-weight:700;color:#14262F;">Hello <%= @resource.email %>!</p>

<p style="margin:0 0 16px;font-size:15px;line-height:24px;color:#3B5260;">Your account has been locked due to an excessive number of unsuccessful sign in attempts.</p>

<p style="margin:0 0 16px;font-size:15px;line-height:24px;color:#3B5260;">Click the link below to unlock your account:</p>

<p style="margin:24px 0;">
  <%= link_to 'Unlock my account', unlock_url(@resource, unlock_token: @token), style: "display:inline-block;background:#1D7C79;color:#ffffff;text-decoration:none;font-weight:600;font-size:15px;padding:12px 24px;border-radius:8px;" %>
</p>
