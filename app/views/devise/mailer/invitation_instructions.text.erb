<%= t("devise.mailer.invitation_instructions.hello", first_name: @resource.first_name, last_name: @resource.last_name) %>

<%= t("devise.mailer.invitation_instructions.someone_invited_you",
       inviter_first_name: @resource.invited_by&.first_name || "Someone",
       inviter_last_name: @resource.invited_by&.last_name || "",
       url: root_url) %>

<%= accept_invitation_url(@resource, invitation_token: @token) %>

<% if @resource.invitation_due_at %>
<%= t("devise.mailer.invitation_instructions.accept_until", due_date: l(@resource.invitation_due_at, format: :'devise.mailer.invitation_instructions.accept_until_format')) %>
<% end %>
<% if @resource.user_pass.present? %>

Your secret word (never share it with anyone): <%= @resource.user_pass %>
<% end %>

Regards,
<%= [@resource.invited_by&.first_name, @resource.invited_by&.last_name].compact.join(" ").presence || "The MAL Payments team" %>

<%= t("devise.mailer.invitation_instructions.ignore") %>

--
MAL Payments
