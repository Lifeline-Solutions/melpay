<%# Signed-out page frame: brand panel on the left, form on the right.
    Usage: render layout: "devise/shared/auth_shell", passing heading and subheading, with the form in the block. %>
<%# locals: (heading:, subheading:) %>
<% content_for :head do %>
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=Public+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<% end %>

<div class="flex min-h-screen w-full flex-col bg-white font-sans text-ink antialiased md:flex-row">
  <aside class="hidden flex-col justify-between bg-ink px-12 py-12 text-white md:flex md:w-[44%] lg:w-1/2">
    <%= link_to root_path, class: "inline-block w-fit rounded-lg bg-white px-3 py-2" do %>
      <%= image_tag "logo.png", alt: "MAL Payments", class: "h-10 w-auto" %>
    <% end %>

    <div>
      <h1 class="max-w-md font-display text-4xl font-bold leading-tight tracking-tight lg:text-5xl"><%= heading %></h1>
      <p class="mt-5 max-w-sm text-lg leading-relaxed text-white/75"><%= subheading %></p>
    </div>

    <p class="text-sm text-white/55">&copy; <%= Date.current.year %> MAL Payments. All rights reserved.</p>
  </aside>

  <main class="flex flex-1 items-center justify-center px-6 py-12">
    <div class="w-full max-w-sm">
      <%= link_to root_path, class: "mb-10 inline-block md:hidden" do %>
        <%= image_tag "logo.png", alt: "MAL Payments", class: "h-10 w-auto" %>
      <% end %>

      <%= render "devise/shared/flash" %>
      <%= yield %>

      <p class="mt-12 text-center text-xs text-ink-2 md:hidden">&copy; <%= Date.current.year %> MAL Payments. All rights reserved.</p>
    </div>
  </main>
</div>
