<% provide(:title, "Unlock Account") %>

<%= render layout: "devise/shared/auth_shell",
           locals: { heading: "Your account is locked for your safety.",
                     subheading: "Too many unsuccessful sign-in attempts lock an account. We'll email you a link to unlock it." } do %>

  <h2 class="font-display text-2xl font-bold text-ink">Resend unlock instructions</h2>
  <p class="mt-1 text-sm text-ink-2 mb-8">Enter the email on your account.</p>

  <%= form_for(resource, as: resource_name, url: unlock_path(resource_name), html: { method: :post, class: "space-y-5" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div>
      <%= f.label :email, "Email", class: "mb-2 block text-sm font-semibold text-ink" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true,
                        placeholder: "you@company.com", class: "block h-12 w-full rounded-lg border border-line bg-white px-4 text-ink placeholder:text-ink-2/50 focus:border-teal-deep focus:outline-none focus:ring-2 focus:ring-teal/30" %>
    </div>

    <%= f.submit "Resend unlock instructions", class: "h-12 w-full cursor-pointer rounded-lg bg-ink font-semibold text-white hover:bg-teal-deep focus:outline-none focus-visible:ring-2 focus-visible:ring-teal focus-visible:ring-offset-2" %>
  <% end %>

  <div class="mt-8 space-y-2 border-t border-line pt-6 text-sm">
    <%= render "devise/shared/restricted_links" %>
  </div>
<% end %>
