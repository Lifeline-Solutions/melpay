<% provide(:title, "Create Account") %>

<%= render layout: "devise/shared/auth_shell",
           locals: { heading: "Collections and disbursements, on one platform.",
                     subheading: "Create your MAL Payments account. We'll verify your business before live payments are switched on." } do %>

  <h2 class="font-display text-2xl font-bold text-ink">Create your account</h2>
  <p class="mt-1 text-sm text-ink-2 mb-8">It takes less than a minute.</p>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-5" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div>
      <%= f.label :email, "Email", class: "mb-2 block text-sm font-semibold text-ink" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true,
                        placeholder: "you@company.com", class: "block h-12 w-full rounded-lg border border-line bg-white px-4 text-ink placeholder:text-ink-2/50 focus:border-teal-deep focus:outline-none focus:ring-2 focus:ring-teal/30" %>
    </div>

    <div>
      <%= f.label :password, "Password", class: "mb-2 block text-sm font-semibold text-ink" %>
      <%= f.password_field :password, autocomplete: "new-password", required: true,
                           class: "block h-12 w-full rounded-lg border border-line bg-white px-4 text-ink placeholder:text-ink-2/50 focus:border-teal-deep focus:outline-none focus:ring-2 focus:ring-teal/30" %>
      <% if @minimum_password_length %>
        <p class="mt-1.5 text-xs text-ink-2"><%= @minimum_password_length %> characters minimum</p>
      <% end %>
    </div>

    <div>
      <%= f.label :password_confirmation, "Confirm password", class: "mb-2 block text-sm font-semibold text-ink" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true,
                           class: "block h-12 w-full rounded-lg border border-line bg-white px-4 text-ink placeholder:text-ink-2/50 focus:border-teal-deep focus:outline-none focus:ring-2 focus:ring-teal/30" %>
    </div>

    <%= f.submit "Create account", class: "h-12 w-full cursor-pointer rounded-lg bg-ink font-semibold text-white hover:bg-teal-deep focus:outline-none focus-visible:ring-2 focus-visible:ring-teal focus-visible:ring-offset-2" %>
  <% end %>

  <div class="mt-8 space-y-2 border-t border-line pt-6 text-sm">
    <p class="text-ink-2">Already have an account?</p>
    <%= render "devise/shared/links" %>
  </div>
<% end %>
