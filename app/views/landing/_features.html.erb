<section class="section" id="features">
  <div class="features-header">
    <div>
      <div class="section-tag">Everything You Need</div>
      <h2 class="section-title">One platform.<br>Infinite possibilities.</h2>
    </div>
    <p class="section-sub">
      From one-click collections to bulk disbursements, MAL Payments handles the full payments lifecycle so you can focus on growing your business.
    </p>
  </div>

  <div class="features-grid">
    <div class="feature-card large">
      <div class="feature-icon">
        <%# Arrows right-left — bulk transfer %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21 3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5" />
        </svg>
      </div>
      <div>
        <div class="feature-title">Bulk Disbursements at Scale</div>
        <p class="feature-desc">Pay thousands of agents, suppliers, or employees in a single batch. Smart routing ensures every payment lands on time, every time — with full audit trails.</p>
      </div>
    </div>

    <div class="feature-card">
      <div class="feature-icon">
        <%# Device phone mobile — mobile collections %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 0 0 6 3.75v16.5a2.25 2.25 0 0 0 2.25 2.25h7.5A2.25 2.25 0 0 0 18 20.25V3.75a2.25 2.25 0 0 0-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 15.75h3" />
        </svg>
      </div>
      <div class="feature-title">Mobile Collections</div>
      <p class="feature-desc">Accept M-Pesa, Airtel Money, and card payments through a single integration. No more juggling multiple providers.</p>
    </div>

    <div class="feature-card">
      <div class="feature-icon">
        <%# Chart bar — analytics %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" />
        </svg>
      </div>
      <div class="feature-title">Real-time Analytics</div>
      <p class="feature-desc">Live dashboards show you exactly what's flowing through your business. Drill into every transaction in seconds.</p>
    </div>

    <div class="feature-card">
      <div class="feature-icon">
        <%# Code bracket — developer API %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5" />
        </svg>
      </div>
      <div class="feature-title">Developer API</div>
      <p class="feature-desc">RESTful APIs with SDKs for Ruby, Python, Node &amp; more. Go live in hours, not weeks, with our comprehensive documentation.</p>
    </div>

    <div class="feature-card">
      <div class="feature-icon">
        <%# Clipboard document check — reconciliation %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M11.35 3.836c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m8.9-4.414c.376.023.75.05 1.124.08 1.131.094 1.976 1.057 1.976 2.192V16.5A2.25 2.25 0 0 1 18 18.75h-2.25m-7.5-10.5H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V18.75m-7.5-10.5h6.375c.621 0 1.125.504 1.125 1.125v9.375m-8.25-3 1.5 1.5 3-3.75" />
        </svg>
      </div>
      <div class="feature-title">Automated Reconciliation</div>
      <p class="feature-desc">Auto-match payments to invoices, flag discrepancies, and generate reports your finance team will love.</p>
    </div>

    <div class="feature-card">
      <div class="feature-icon">
        <%# Credit card — virtual cards %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 0 0 2.25-2.25V6.75A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25v10.5A2.25 2.25 0 0 0 4.5 19.5Z" />
        </svg>
      </div>
      <div class="feature-title">Virtual Cards</div>
      <p class="feature-desc">Issue virtual prepaid cards to your team or customers instantly. Set spend limits and expiry dates with a single click.</p>
    </div>
  </div>
</section>
