<section class="bg-mist">
  <div class="mx-auto grid max-w-6xl gap-12 px-5 pb-16 pt-14 lg:grid-cols-[1.1fr_1fr] lg:items-center lg:px-8 lg:pb-24 lg:pt-20">
    <div>
      <p class="inline-block rounded-full border border-teal/40 bg-white px-3 py-1 text-sm font-semibold text-teal-deep">Payment Aggregator Platform</p>
      <h1 class="mt-5 font-display text-[2.6rem] font-extrabold leading-[1.02] tracking-tight text-ink sm:text-6xl lg:text-[4.1rem]">
        Collections &amp;<br>Disbursements,<br>Simplified
      </h1>
      <p class="mt-6 max-w-[34rem] text-lg leading-relaxed text-ink-2">
        MAL Payments gives businesses a single, powerful platform to collect payments, disburse funds, and manage every transaction — all with enterprise-grade security.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="<%= new_user_session_path %>" class="rounded-lg bg-teal-deep px-6 py-3.5 font-semibold text-white hover:bg-ink">Get Started Free</a>
        <a href="#how-it-works" class="rounded-lg border border-ink/20 bg-white px-6 py-3.5 font-semibold text-ink hover:border-ink">See How It Works</a>
      </div>
      <dl class="mt-12 grid max-w-lg grid-cols-3 divide-x divide-line border-t border-line pt-6">
        <div class="flex flex-col pr-4">
          <dt class="text-sm text-ink-2">Uptime SLA</dt>
          <dd class="order-first font-display text-2xl font-bold text-ink sm:text-3xl">99.9%</dd>
        </div>
        <div class="flex flex-col px-4">
          <dt class="text-sm text-ink-2">Avg. Transaction Processing Time</dt>
          <dd class="order-first font-display text-2xl font-bold text-ink sm:text-3xl">&lt;10s</dd>
        </div>
        <div class="flex flex-col pl-4">
          <dt class="text-sm text-ink-2">Encryption</dt>
          <dd class="order-first font-display text-2xl font-bold text-ink sm:text-3xl">256-bit</dd>
        </div>
      </dl>
    </div>

    <!-- Static product view: a disbursement batch -->
    <figure class="rounded-2xl border border-line bg-white shadow-[0_24px_60px_-30px_rgba(20,38,47,0.45)]" aria-label="Example disbursement batch in the MAL Payments dashboard">
      <div class="flex items-center justify-between border-b border-line px-5 py-4">
        <div>
          <p class="text-xs font-medium text-ink-2">Bulk disbursement</p>
          <p class="font-display text-lg font-bold text-ink">Supplier payouts, week 43</p>
        </div>
        <span class="shrink-0 whitespace-nowrap rounded-full bg-mist px-3 py-1 text-xs font-semibold text-teal-deep">118 of 120 paid</span>
      </div>
      <table class="w-full text-left text-sm">
        <thead class="text-xs text-ink-2">
          <tr><th class="px-5 py-2.5 font-medium">Recipient</th><th class="hidden py-2.5 font-medium sm:table-cell">Channel</th><th class="py-2.5 text-right font-medium">Amount</th><th class="px-5 py-2.5 text-right font-medium">Status</th></tr>
        </thead>
        <tbody class="divide-y divide-line text-ink">
          <tr><td class="px-5 py-3">Achol Deng</td><td class="hidden py-3 text-ink-2 sm:table-cell">MTN MoMo</td><td class="whitespace-nowrap py-3 text-right tabular-nums">USD 85.00</td><td class="px-5 py-3 text-right"><span class="font-semibold text-teal-deep">Paid</span></td></tr>
          <tr><td class="px-5 py-3">Juba Grain Traders</td><td class="hidden py-3 text-ink-2 sm:table-cell">Bank</td><td class="whitespace-nowrap py-3 text-right tabular-nums">USD 1,240.00</td><td class="px-5 py-3 text-right"><span class="font-semibold text-teal-deep">Paid</span></td></tr>
          <tr><td class="px-5 py-3">Wani Lado</td><td class="hidden py-3 text-ink-2 sm:table-cell">M-Pesa</td><td class="whitespace-nowrap py-3 text-right tabular-nums">USD 42.50</td><td class="px-5 py-3 text-right"><span class="font-semibold text-teal-deep">Paid</span></td></tr>
          <tr><td class="px-5 py-3">Nyandit Cooperative</td><td class="hidden py-3 text-ink-2 sm:table-cell">Airtel Money</td><td class="whitespace-nowrap py-3 text-right tabular-nums">USD 310.00</td><td class="px-5 py-3 text-right"><span class="font-semibold text-amber">Processing</span></td></tr>
        </tbody>
      </table>
      <div class="flex items-center justify-between border-t border-line bg-mist/60 px-5 py-4 text-sm">
        <span class="text-ink-2">Batch total</span>
        <span class="font-display text-lg font-bold tabular-nums text-ink">USD 18,640.00</span>
      </div>
    </figure>
  </div>
</section>
