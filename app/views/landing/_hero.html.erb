<section class="hero">
  <div class="hero-content">
    <div class="hero-badge">Licensed &amp; Regulated Payments Platform</div>
    <h1 class="hero-title">
      Collections &amp;<br>Disbursements,<br><em>Simplified</em>
    </h1>
    <p class="hero-sub">
      MAL Payments gives businesses a single, powerful platform to collect payments, disburse funds, and manage every transaction — all with enterprise-grade security.
    </p>
    <div class="hero-actions">
      <%= link_to new_user_registration_path, class: "btn-primary" do %>
        Get Started Free
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
      <% end %>
      <a href="#how-it-works" class="btn-secondary">See How It Works</a>
    </div>
    <div class="hero-stats">
      <div>
        <div class="stat-num">99.9%</div>
        <div class="stat-label">Uptime SLA</div>
      </div>
      <div>
        <div class="stat-num">2s</div>
        <div class="stat-label">Avg. Settlement</div>
      </div>
      <div>
        <div class="stat-num">256-bit</div>
        <div class="stat-label">Encryption</div>
      </div>
    </div>
  </div>

  <div class="hero-visual">
    <div class="card-stack">
      <div class="pay-card">
        <div class="card-row">
          <div class="card-chip"></div>
          <div class="card-logo">MAL</div>
        </div>
        <div>
          <div class="card-name">Jane Doe</div>
          <div class="card-num">•••• •••• •••• 9012</div>
        </div>
      </div>
      <div class="pay-card">
        <div class="card-row">
          <div class="card-chip"></div>
          <div class="card-logo">MAL</div>
        </div>
        <div>
          <div class="card-name">Jane Doe</div>
          <div class="card-num">•••• •••• •••• 5678</div>
        </div>
      </div>
      <div class="pay-card">
        <div class="card-row">
          <div class="card-chip"></div>
          <div class="card-logo">MAL</div>
        </div>
        <div>
          <div class="card-name">Jane Doe</div>
          <div class="card-num">•••• •••• •••• 1234</div>
        </div>
      </div>

      <div class="float-pill pill-1">
        <span class="pill-dot"></span> Payment received · KES 4,250
      </div>
      <div class="float-pill pill-2">
        <span class="pill-icon">💸</span> Disbursed to 120 agents
      </div>
      <div class="float-pill pill-3">
        <span class="pill-dot gold"></span> Instant settlement
      </div>
    </div>
  </div>
</section>
