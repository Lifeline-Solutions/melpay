<form id="contact-form" action="/contact" method="post" accept-charset="UTF-8" class="scroll-mt-24 rounded-2xl border border-line p-8">
        <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
        <div class="grid gap-5 sm:grid-cols-2">
          <label class="block">
            <span class="text-sm font-semibold text-ink">Full Name*</span>
            <input type="text" name="name" required autocomplete="name" class="mt-2 w-full rounded-lg border border-line bg-white px-4 py-3 text-ink focus:border-teal-deep focus:outline-none">
          </label>
          <label class="block">
            <span class="text-sm font-semibold text-ink">Email*</span>
            <input type="email" name="email" required autocomplete="email" class="mt-2 w-full rounded-lg border border-line bg-white px-4 py-3 text-ink focus:border-teal-deep focus:outline-none">
          </label>
        </div>
        <label class="mt-5 block">
          <span class="text-sm font-semibold text-ink">Message*</span>
          <textarea name="message" rows="6" required class="mt-2 w-full rounded-lg border border-line bg-white px-4 py-3 text-ink focus:border-teal-deep focus:outline-none"></textarea>
        </label>
        <button type="submit" class="mt-6 rounded-lg bg-ink px-7 py-3 font-semibold text-white hover:bg-teal-deep">Send</button>
      </form>
