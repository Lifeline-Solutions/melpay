<style>
  @import url('https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,300;1,400&display=swap');

  :root {
    --teal:       #00B8C4;
    --teal-dark:  #007A85;
    --teal-light: #E0F7FA;
    --ink:        #0D1F2D;
    --ink-soft:   #3A5068;
    --white:      #FFFFFF;
    --cream:      #F7FBFC;
    --gold:       #F5C842;
    --success:    #22C97A;
    --shadow-lg:  0 32px 80px rgba(0,0,0,0.12);
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html { scroll-behavior: smooth; }

  body {
    font-family: 'Figtree', sans-serif;
    color: var(--ink);
    background: var(--white);
    overflow-x: hidden;
  }

  /* ─── NAV ─────────────────────────────────────── */
  .nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 5vw;
    height: 72px;
    background: rgba(255,255,255,0.92);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(0,184,196,0.12);
    transition: box-shadow .3s;
  }
  .nav.scrolled { box-shadow: 0 4px 24px rgba(0,0,0,0.08); }

  .nav-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
  }
  .nav-logo-img {
    height: 56px;
    width: auto;
    object-fit: contain;
  }

  .nav-links {
    display: flex; align-items: center; gap: 2rem;
    list-style: none;
  }
  .nav-links a {
    font-size: 0.9rem; font-weight: 500;
    color: var(--ink-soft); text-decoration: none;
    transition: color .2s;
  }
  .nav-links a:hover { color: var(--teal); }

  .btn-nav {
    background: var(--ink);
    color: var(--white) !important;
    padding: 0.5rem 1.4rem;
    border-radius: 100px;
    font-size: 0.875rem !important;
    transition: background .2s, transform .15s !important;
  }
  .btn-nav:hover { background: var(--teal) !important; transform: translateY(-1px); }

  /* ─── HERO ────────────────────────────────────── */
  .hero {
    min-height: 100vh;
    padding-top: 72px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 2rem;
    padding-inline: 5vw;
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute; inset: 0;
    background-image:
      linear-gradient(rgba(0,184,196,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0,184,196,0.04) 1px, transparent 1px);
    background-size: 48px 48px;
    pointer-events: none;
  }

  .hero::after {
    content: '';
    position: absolute;
    width: 700px; height: 700px;
    right: -200px; top: -150px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(0,184,196,0.12) 0%, transparent 70%);
    pointer-events: none;
  }

  .hero-content { position: relative; z-index: 2; }

  .hero-badge {
    display: inline-flex; align-items: center; gap: 0.5rem;
    background: var(--teal-light);
    color: var(--teal-dark);
    font-size: 0.78rem; font-weight: 600;
    padding: 0.35rem 1rem;
    border-radius: 100px;
    margin-bottom: 1.5rem;
    border: 1px solid rgba(0,184,196,0.25);
    animation: fadeUp .6s ease both;
  }
  .hero-badge::before { content: '●'; font-size: 0.5rem; color: var(--teal); }

  .hero-title {
    font-family: 'Figtree', sans-serif;
    font-size: clamp(2.4rem, 5vw, 4rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -1.5px;
    color: var(--ink);
    margin-bottom: 1.25rem;
    animation: fadeUp .6s .1s ease both;
  }
  .hero-title em {
    font-style: normal;
    color: var(--teal);
  }

  .hero-sub {
    font-size: 1.05rem;
    color: var(--ink-soft);
    line-height: 1.7;
    max-width: 480px;
    margin-bottom: 2.5rem;
    animation: fadeUp .6s .2s ease both;
  }

  .hero-actions {
    display: flex; gap: 1rem; flex-wrap: wrap;
    animation: fadeUp .6s .3s ease both;
  }

  .btn-primary {
    display: inline-flex; align-items: center; gap: 0.5rem;
    background: var(--teal);
    color: var(--white);
    padding: 0.85rem 2rem;
    border-radius: 100px;
    font-weight: 600; font-size: 0.95rem;
    text-decoration: none;
    box-shadow: 0 8px 32px rgba(0,184,196,0.35);
    transition: transform .2s, box-shadow .2s;
  }
  .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 12px 40px rgba(0,0,0,0.15); }
  .btn-primary svg { width: 16px; height: 16px; }

  .btn-secondary {
    display: inline-flex; align-items: center; gap: 0.5rem;
    background: transparent;
    color: var(--ink);
    padding: 0.85rem 2rem;
    border-radius: 100px;
    font-weight: 600; font-size: 0.95rem;
    text-decoration: none;
    border: 1.5px solid rgba(13,31,45,0.18);
    transition: border-color .2s, color .2s;
  }
  .btn-secondary:hover { border-color: var(--teal); color: var(--teal); }

  .hero-stats {
    display: flex; gap: 2.5rem; margin-top: 3rem;
    padding-top: 2.5rem;
    border-top: 1px solid rgba(0,184,196,0.15);
    animation: fadeUp .6s .4s ease both;
  }
  .stat-num {
    font-family: 'Figtree', sans-serif;
    font-size: 1.6rem; font-weight: 800;
    color: var(--ink);
  }
  .stat-label {
    font-size: 0.78rem; color: var(--ink-soft); margin-top: 0.1rem;
  }

  .hero-visual {
    position: relative; z-index: 2;
    display: flex; align-items: center; justify-content: center;
    animation: fadeUp .7s .15s ease both;
  }

  .card-stack {
    position: relative;
    width: 320px; height: 380px;
  }

  .pay-card {
    position: absolute;
    width: 280px; height: 170px;
    border-radius: 18px;
    background: linear-gradient(135deg, #1a2e3b 0%, #0d1f2d 100%);
    box-shadow: 0 24px 64px rgba(0,0,0,0.3);
    padding: 1.5rem;
    display: flex; flex-direction: column; justify-content: space-between;
    transition: transform .3s;
  }
  .pay-card:nth-child(1) {
    transform: rotate(-8deg) translateY(40px);
    background: linear-gradient(135deg, #0D3B47 0%, #051820 100%);
  }
  .pay-card:nth-child(2) {
    transform: rotate(-3deg) translateY(20px);
    background: linear-gradient(135deg, #1F4D5C 0%, #0d2f3a 100%);
    z-index: 2;
  }
  .pay-card:nth-child(3) {
    transform: rotate(2deg);
    background: linear-gradient(135deg, #005F73 0%, #0d3545 100%);
    z-index: 3;
  }

  .card-chip {
    width: 36px; height: 28px;
    border-radius: 5px;
    background: linear-gradient(135deg, #d4a547, #f5c842);
    box-shadow: inset 0 1px 2px rgba(255,255,255,0.3);
  }
  .card-logo {
    width: 32px; height: 32px;
    border-radius: 50%;
    background: rgba(255,255,255,0.15);
    border: 1.5px solid rgba(255,255,255,0.25);
    display: flex; align-items: center; justify-content: center;
    font-family: 'Figtree',sans-serif; font-weight: 800; font-size: 0.55rem;
    color: white;
    align-self: flex-start;
  }
  .card-row { display: flex; justify-content: space-between; align-items: flex-end; }
  .card-name {
    font-size: 0.7rem; color: rgba(255,255,255,0.7);
    font-weight: 500; letter-spacing: 0.5px;
  }
  .card-num {
    font-size: 0.6rem; color: rgba(255,255,255,0.4);
    letter-spacing: 1px;
  }

  .float-pill {
    position: absolute;
    background: white;
    border-radius: 14px;
    box-shadow: 0 12px 32px rgba(0,0,0,0.12);
    padding: 0.65rem 1rem;
    display: flex; align-items: center; gap: 0.6rem;
    font-size: 0.78rem; font-weight: 600; color: var(--ink);
    white-space: nowrap;
    animation: float 4s ease-in-out infinite;
  }
  .float-pill.pill-1 { top: 10px; right: -20px; animation-delay: 0s; }
  .float-pill.pill-2 { bottom: 60px; left: -40px; animation-delay: 1.2s; }
  .float-pill.pill-3 { bottom: 10px; right: 10px; animation-delay: 2.5s; }

  .pill-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--success); flex-shrink: 0;
  }
  .pill-dot.gold { background: var(--gold); }
  .pill-icon { font-size: 1rem; }

  /* ─── TRUST BAR ───────────────────────────────── */
  .trust-bar {
    background: var(--ink);
    color: rgba(255,255,255,0.6);
    padding: 1.2rem 5vw;
    display: flex; align-items: center; justify-content: center; gap: 3rem; flex-wrap: wrap;
    font-size: 0.8rem; font-weight: 500; letter-spacing: 0.5px;
  }
  .trust-bar span { color: rgba(255,255,255,0.35); }
  .trust-item { display: flex; align-items: center; gap: 0.5rem; }
  .trust-item svg { width: 14px; height: 14px; color: var(--teal); flex-shrink: 0; }

  /* ─── FEATURES ────────────────────────────────── */
  .section { padding: 7rem 5vw; }

  .section-tag {
    display: inline-block;
    font-size: 0.75rem; font-weight: 700; letter-spacing: 1.5px;
    text-transform: uppercase; color: var(--teal);
    margin-bottom: 0.75rem;
  }

  .section-title {
    font-family: 'Figtree', sans-serif;
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
    font-weight: 800; letter-spacing: -1px;
    color: var(--ink); line-height: 1.15;
    margin-bottom: 1rem;
  }
  .section-sub {
    font-size: 1rem; color: var(--ink-soft); max-width: 520px; line-height: 1.7;
  }

  .features-header {
    display: flex; justify-content: space-between; align-items: flex-end;
    margin-bottom: 3.5rem; flex-wrap: wrap; gap: 1.5rem;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .feature-card {
    background: var(--cream);
    border: 1px solid rgba(0,184,196,0.1);
    border-radius: 20px;
    padding: 2rem;
    transition: transform .25s, box-shadow .25s, border-color .25s;
    position: relative; overflow: hidden;
  }
  .feature-card::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0; height: 3px;
    background: linear-gradient(90deg, var(--teal), transparent);
    opacity: 0; transition: opacity .25s;
  }
  .feature-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: rgba(0,184,196,0.25);
  }
  .feature-card:hover::before { opacity: 1; }

  .feature-icon {
    width: 52px; height: 52px;
    border-radius: 14px;
    background: rgba(0,184,196,0.12);
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 1.25rem;
    font-size: 1.35rem;
  }
  .feature-title {
    font-family: 'Figtree', sans-serif;
    font-size: 1.05rem; font-weight: 700;
    color: var(--ink); margin-bottom: 0.5rem;
  }
  .feature-desc {
    font-size: 0.875rem; color: var(--ink-soft); line-height: 1.65;
  }

  .feature-card.large {
    grid-column: span 2;
    background: var(--ink);
    color: white;
    display: flex; gap: 2rem; align-items: center;
  }
  .feature-card.large .feature-title { color: white; font-size: 1.3rem; }
  .feature-card.large .feature-desc { color: rgba(255,255,255,0.6); }
  .feature-card.large .feature-icon {
    background: rgba(0,184,196,0.2); flex-shrink: 0;
    width: 64px; height: 64px; border-radius: 16px; font-size: 1.6rem;
  }

  /* ─── HOW IT WORKS ────────────────────────────── */
  .how {
    background: var(--ink);
    padding: 7rem 5vw;
    position: relative; overflow: hidden;
  }
  .how::before {
    content: '';
    position: absolute; width: 600px; height: 600px;
    top: -200px; right: -200px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(0,184,196,0.15) 0%, transparent 70%);
    pointer-events: none;
  }

  .how .section-tag { color: var(--teal); }
  .how .section-title { color: white; }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem; margin-top: 3.5rem;
    position: relative;
  }
  .steps-grid::before {
    content: '';
    position: absolute;
    top: 30px; left: 60px; right: 60px; height: 1px;
    background: linear-gradient(90deg, transparent, rgba(0,184,196,0.4), transparent);
  }

  .step {
    text-align: center;
    position: relative; z-index: 2;
  }
  .step-num {
    width: 60px; height: 60px;
    border-radius: 50%;
    border: 2px solid var(--teal);
    background: rgba(0,184,196,0.12);
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 1.25rem;
    font-family: 'Figtree', sans-serif; font-size: 1.1rem; font-weight: 800;
    color: var(--teal);
  }
  .step-title {
    font-family: 'Figtree', sans-serif; font-weight: 700;
    color: white; font-size: 0.95rem; margin-bottom: 0.5rem;
  }
  .step-desc {
    font-size: 0.82rem; color: rgba(255,255,255,0.5); line-height: 1.6;
  }

  /* ─── SECURITY ────────────────────────────────── */
  .security {
    padding: 7rem 5vw;
    background: linear-gradient(135deg, #E8F8FA 0%, #F7FBFC 60%, #fff 100%);
  }

  .security-inner {
    display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: center;
  }

  .security-badges {
    display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 2.5rem;
  }
  .security-badge {
    background: white; border-radius: 16px;
    padding: 1.25rem 1rem;
    display: flex; align-items: center; gap: 0.75rem;
    box-shadow: 0 4px 16px rgba(0,184,196,0.08);
    border: 1px solid rgba(0,184,196,0.12);
  }
  .security-badge-icon { font-size: 1.4rem; flex-shrink: 0; }
  .security-badge-label { font-size: 0.8rem; font-weight: 600; color: var(--ink); }
  .security-badge-sub { font-size: 0.7rem; color: var(--ink-soft); }

  .security-visual {
    position: relative;
    display: flex; align-items: center; justify-content: center;
  }

  .security-ring {
    width: 300px; height: 300px;
    border-radius: 50%;
    border: 1px dashed rgba(0,184,196,0.3);
    display: flex; align-items: center; justify-content: center;
    position: relative;
    animation: spin 30s linear infinite;
  }
  .security-ring-inner {
    width: 200px; height: 200px;
    border-radius: 50%;
    border: 1px solid rgba(0,184,196,0.5);
    background: radial-gradient(circle, rgba(0,184,196,0.12), white);
    display: flex; align-items: center; justify-content: center;
    animation: spin 30s linear reverse infinite;
  }
  .security-shield {
    font-size: 3.5rem;
    animation: spin 30s linear infinite;
  }
  .orbit-dot {
    position: absolute;
    width: 12px; height: 12px; border-radius: 50%;
    background: var(--teal);
    box-shadow: 0 0 12px var(--teal);
  }
  .orbit-dot:nth-child(1) { top: -6px; left: 50%; transform: translateX(-50%); }
  .orbit-dot:nth-child(2) { bottom: -6px; left: 50%; transform: translateX(-50%); }
  .orbit-dot:nth-child(3) { left: -6px; top: 50%; transform: translateY(-50%); }
  .orbit-dot:nth-child(4) { right: -6px; top: 50%; transform: translateY(-50%); }

  /* ─── PRICING ──────────────────────────── */
  .pricing-section {
    padding: 7rem 5vw;
    text-align: center;
    background: var(--white);
  }

  .pricing-cards {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem; margin-top: 3.5rem;
    max-width: 900px; margin-inline: auto; margin-top: 3.5rem;
  }

  .pricing-card {
    border: 1.5px solid rgba(0,184,196,0.15);
    border-radius: 20px;
    padding: 2rem;
    text-align: left; position: relative;
    transition: transform .25s, box-shadow .25s;
  }
  .pricing-card.featured {
    background: var(--ink);
    border-color: var(--teal);
    transform: scale(1.05);
    box-shadow: 0 24px 80px rgba(0,184,196,0.25);
  }
  .pricing-card:not(.featured):hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }

  .pricing-tag {
    position: absolute; top: -14px; left: 50%; transform: translateX(-50%);
    background: var(--teal);
    color: white; font-size: 0.7rem; font-weight: 700;
    padding: 0.3rem 1rem; border-radius: 100px;
    letter-spacing: 0.5px; white-space: nowrap;
  }

  .pricing-plan {
    font-size: 0.75rem; font-weight: 700; letter-spacing: 1px;
    text-transform: uppercase; color: var(--teal); margin-bottom: 0.75rem;
  }
  .pricing-price {
    font-family: 'Figtree', sans-serif;
    font-size: 2.2rem; font-weight: 800; color: var(--ink);
    margin-bottom: 0.25rem;
  }
  .pricing-card.featured .pricing-price { color: white; }
  .pricing-price sup { font-size: 1rem; vertical-align: super; }
  .pricing-price sub { font-size: 0.8rem; color: var(--ink-soft); font-weight: 400; }
  .pricing-card.featured .pricing-price sub { color: rgba(255,255,255,0.5); }
  .pricing-desc {
    font-size: 0.82rem; color: var(--ink-soft); margin-bottom: 1.5rem; line-height: 1.5;
  }
  .pricing-card.featured .pricing-desc { color: rgba(255,255,255,0.6); }

  .pricing-features { list-style: none; margin-bottom: 2rem; }
  .pricing-features li {
    font-size: 0.83rem; padding: 0.35rem 0;
    display: flex; gap: 0.5rem; align-items: center; color: var(--ink-soft);
  }
  .pricing-card.featured .pricing-features li { color: rgba(255,255,255,0.75); }
  .pricing-features li::before { content: '✓'; color: var(--teal); font-weight: 700; flex-shrink: 0; }

  .btn-plan {
    display: block; text-align: center;
    padding: 0.75rem; border-radius: 100px;
    font-weight: 600; font-size: 0.875rem;
    text-decoration: none;
    background: rgba(0,184,196,0.1); color: var(--teal);
    transition: background .2s;
  }
  .pricing-card.featured .btn-plan {
    background: var(--teal); color: white;
    box-shadow: 0 8px 24px rgba(0,184,196,0.35);
  }
  .btn-plan:hover { background: rgba(0,184,196,0.2); }
  .pricing-card.featured .btn-plan:hover { background: #00a0ab; }

  /* ─── ABOUT ───────────────────────────────────── */
  .about-section {
    padding: 7rem 5vw;
    background: var(--cream);
  }
  .about-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
  }
  .about-stats {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    padding-left: 2rem;
    border-left: 2px solid rgba(0,184,196,0.2);
  }
  .about-stat .stat-num {
    font-size: 2rem;
  }

  /* ─── CTA + CONTACT ROW ────────────────────────── */
  .cta-contact-section {
    padding: 0 5vw 5rem;
  }
  .contact-title {
    font-family: 'Figtree', sans-serif;
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 800;
    letter-spacing: -0.5px;
    color: var(--ink);
    text-align: center;
    margin-bottom: 1.5rem;
  }
  .cta-contact-row {
    display: flex;
    gap: 2rem;
    align-items: stretch;
  }

  /* ─── CTA ─────────────────────────────────────── */
  .cta {
    flex: 1;
    margin: 0;
    background: var(--ink);
    border-radius: 28px;
    padding: 5rem 4rem;
    display: flex; justify-content: space-between; align-items: center;
    gap: 2rem; flex-wrap: wrap;
    position: relative; overflow: hidden;
  }
  .cta::before {
    content: '';
    position: absolute; width: 500px; height: 500px;
    right: -100px; top: -200px; border-radius: 50%;
    background: radial-gradient(circle, rgba(0,184,196,0.2) 0%, transparent 70%);
    pointer-events: none;
  }
  .cta-text { position: relative; z-index: 2; }
  .cta-title {
    font-family: 'Figtree', sans-serif;
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 800; color: white; margin-bottom: 0.75rem;
    letter-spacing: -0.5px;
  }
  .cta-sub { font-size: 0.95rem; color: rgba(255,255,255,0.55); }
  .cta-actions {
    display: flex; gap: 1rem; flex-wrap: wrap; flex-shrink: 0;
    position: relative; z-index: 2;
  }
  .btn-cta-primary {
    background: var(--teal); color: white;
    padding: 0.9rem 2.2rem; border-radius: 100px;
    font-weight: 600; font-size: 0.95rem; text-decoration: none;
    box-shadow: 0 8px 32px rgba(0,184,196,0.4);
    transition: transform .2s, box-shadow .2s;
  }
  .btn-cta-primary:hover { transform: translateY(-2px); box-shadow: 0 12px 40px rgba(0,0,0,0.15); }
  .btn-cta-secondary {
    background: rgba(255,255,255,0.08); color: rgba(255,255,255,0.8);
    padding: 0.9rem 2.2rem; border-radius: 100px;
    font-weight: 600; font-size: 0.95rem; text-decoration: none;
    border: 1px solid rgba(255,255,255,0.15);
    transition: background .2s, border-color .2s;
  }
