<section class="pricing-section" id="pricing">
  <div class="section-tag">Transparent Pricing</div>
  <h2 class="section-title">Simple, honest pricing</h2>
  <p class="section-sub" style="margin-inline:auto;text-align:center;margin-top:0.5rem">
    No hidden fees. No nasty surprises. Pay only for what you use.
  </p>

  <div class="pricing-cards">
    <div class="pricing-card">
      <div class="pricing-plan">Starter</div>
      <div class="pricing-price"><sup>KES</sup>0<sub>/mo</sub></div>
      <p class="pricing-desc">Perfect for testing and small-volume businesses getting started.</p>
      <ul class="pricing-features">
        <li>Up to 100 transactions/mo</li>
        <li>1.5% + KES 5 per transaction</li>
        <li>M-Pesa &amp; Airtel Money</li>
        <li>Basic dashboard</li>
        <li>Email support</li>
      </ul>
      <%= link_to "Get Started", new_user_registration_path, class: "btn-plan" %>
    </div>

    <div class="pricing-card featured">
      <div class="pricing-tag">Most Popular</div>
      <div class="pricing-plan">Growth</div>
      <div class="pricing-price"><sup>KES</sup>4,999<sub>/mo</sub></div>
      <p class="pricing-desc">For growing businesses that need more volume and advanced features.</p>
      <ul class="pricing-features">
        <li>Unlimited transactions</li>
        <li>1.0% + KES 3 per transaction</li>
        <li>All payment channels</li>
        <li>Bulk disbursements</li>
        <li>API access + webhooks</li>
        <li>Priority support</li>
      </ul>
      <%= link_to "Start Free Trial", new_user_registration_path, class: "btn-plan" %>
    </div>

    <div class="pricing-card">
      <div class="pricing-plan">Enterprise</div>
      <div class="pricing-price" style="font-size:1.6rem">Custom</div>
      <p class="pricing-desc">Tailored solutions for large enterprises with unique requirements.</p>
      <ul class="pricing-features">
        <li>Negotiated transaction rates</li>
        <li>Dedicated account manager</li>
        <li>Custom integrations</li>
        <li>SLA guarantees</li>
        <li>On-site onboarding</li>
      </ul>
      <a href="/contact" class="btn-plan">Contact Sales</a>
    </div>
  </div>
</section>
