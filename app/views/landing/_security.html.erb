<section class="security" id="security">
  <div class="security-inner">
    <div>
      <div class="section-tag">Security First</div>
      <h2 class="section-title">Protecting you<br>and your money</h2>
      <p class="section-sub">
        We built MAL Payments on a foundation of trust. Every transaction is encrypted, monitored, and backed by industry-leading compliance standards.
      </p>
      <div class="security-badges">
        <div class="security-badge">
          <div class="security-badge-icon">
            <%# Lock closed — SSL encryption %>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
            </svg>
          </div>
          <div>
            <div class="security-badge-label">256-bit SSL</div>
            <div class="security-badge-sub">End-to-end encryption</div>
          </div>
        </div>
        <div class="security-badge">
          <div class="security-badge-icon">
            <%# Shield check — PCI-DSS %>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
            </svg>
          </div>
          <div>
            <div class="security-badge-label">PCI-DSS Level 1</div>
            <div class="security-badge-sub">Highest card security</div>
          </div>
        </div>
        <div class="security-badge">
          <div class="security-badge-icon">
            <%# Eye — fraud detection %>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
            </svg>
          </div>
          <div>
            <div class="security-badge-label">Fraud Detection</div>
            <div class="security-badge-sub">Real-time AI monitoring</div>
          </div>
        </div>
        <div class="security-badge">
          <div class="security-badge-icon">
            <%# Building library — CBK licensed/regulatory %>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.332A48.36 48.36 0 0 0 12 9.75c-2.551 0-5.056.2-7.5.582V21M3 21h18M12 6.75h.008v.008H12V6.75Z" />
            </svg>
          </div>
          <div>
            <div class="security-badge-label">CBK Licensed</div>
            <div class="security-badge-sub">Fully regulated</div>
          </div>
        </div>
      </div>
    </div>

    <div class="security-visual">
      <div class="security-ring">
        <div class="orbit-dot"></div>
        <div class="orbit-dot"></div>
        <div class="orbit-dot"></div>
        <div class="orbit-dot"></div>
        <div class="security-ring-inner">
          <div class="security-shield">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
