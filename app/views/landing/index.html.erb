<%= render 'landing/styles' %>
<div class="bg-white font-sans text-ink antialiased">
<%= render 'landing/nav' %>
<main id="main">
  <%= render 'landing/hero' %>
  <%= render 'landing/payment_solution' %>
  <%= render 'landing/about' %>
  <%= render 'landing/features' %>
  <%= render 'landing/how_it_works' %>
  <%= render 'landing/who_we_serve' %>
  <%= render 'landing/security' %>
  <%= render 'landing/pricing' %>
  <%= render 'landing/faq' %>
  <section id="contact" class="scroll-mt-20 border-t border-line bg-white">
    <div class="mx-auto max-w-6xl px-5 py-20 lg:px-8 lg:py-24">
      <h2 class="font-display text-4xl font-bold tracking-tight text-ink sm:text-5xl">Let's Talk</h2>
      <div class="mt-12 grid gap-8 lg:grid-cols-[1fr_1.25fr]">
        <%= render 'landing/cta' %>
        <%= render 'landing/contact' %>
      </div>
    </div>
  </section>
</main>
<%= render 'landing/footer' %>
</div>
