<h1>Interest Rate Management</h1>

<hr>
<h2>Global Interest Rate</h2>
<%= form_with model: @system_setting, url: interest_rates_path, method: :put, local: true do |f| %>
  <div>
    <%= f.label :global_interest_rate, "Set Global Interest Rate (%)" %>
    <%= f.number_field :global_interest_rate, step: 0.01, value: @system_setting.global_interest_rate %>
  </div>
  <div>
    <%= f.submit "Save Global Rate" %>
  </div>
<% end %>

<hr>
<h2>Set Custom Interest Rate for a Client</h2>
<%= form_with url: interest_rates_path, method: :put, local: true do |f| %>
  <div>
    <%= label_tag "client_id", "Select Client" %>
    <%= select_tag "client[id]", options_from_collection_for_select(@clients, :id, :name), prompt: "Choose a client" %>
  </div>
  <div>
    <%= label_tag "custom_interest_rate", "Custom Interest Rate (%)" %>
    <%= number_field_tag "client[custom_interest_rate]", nil, step: 0.01 %>
  </div>
  <div>
    <%= f.submit "Save Custom Rate" %>
  </div>
<% end %>

<hr>
<h2>Current Clients and Their Rates</h2>
<table border="1" cellpadding="5">
  <thead>
    <tr>
      <th>Name</th>
      <th>Email</th>
      <th>Custom Rate</th>
      <th>Effective Rate</th>
    </tr>
  </thead>
  <tbody>
    <% @clients.each do |client| %>
      <tr>
        <td><%= client.name %></td>
        <td><%= client.email %></td>
        <td><%= client.custom_interest_rate || "—" %></td>
        <td><%= client.interest_rate %></td>
      </tr>
    <% end %>
  </tbody>
</table>