<% if current_user && user_signed_in? %>
  <!-- Mobile topbar -->
  <div id="mobile-topbar"
       class="fixed top-0 left-0 right-0 z-40 h-14 flex items-center px-3 bg-white dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700 shadow-sm sm:hidden">
    <button id="sidebar-toggle-btn" type="button"
            class="inline-flex items-center p-2 text-[#122029] rounded-lg hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-[#1FC8C4]/40 dark:text-gray-200 dark:hover:bg-gray-700">
      <span class="sr-only">Open sidebar</span>
      <svg class="w-6 h-6" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
        <path clip-rule="evenodd" fill-rule="evenodd" d="M2 4.75A.75.75 0 012.75 4h14.5a.75.75 0 010 1.5H2.75A.75.75 0 012 4.75zm0 10.5a.75.75 0 01.75-.75h7.5a.75.75 0 010 1.5h-7.5a.75.75 0 01-.75-.75zM2 10a.75.75 0 01.75-.75h14.5a.75.75 0 010 1.5H2.75A.75.75 0 012 10z"></path>
      </svg>
    </button>
    <%= image_tag 'icon.png', class: 'h-8 ms-3' %>
  </div>

  <!-- Backdrop overlay (mobile only) -->
  <div id="sidebar-backdrop" class="fixed inset-0 z-30 bg-[#0B1218]/50 backdrop-blur-sm hidden sm:hidden"></div>

  <aside id="logo-sidebar"
         class="fixed top-0 left-0 z-50 w-64 h-screen -translate-x-full transition-transform duration-300 ease-in-out sm:translate-x-0 shadow-2xl sm:shadow-none"
         aria-label="Sidebar">
    <div class="h-full flex flex-col bg-white border-r border-gray-100">

      <!-- Header: logo + mobile close -->
      <div class="relative shrink-0 flex items-center justify-between gap-3 px-4 py-4 border-b border-gray-100">
        <% if session[:two_factor_authenticated] %>
          <%= link_to home_index_path, id: 'logo-top', class: 'inline-flex items-center' do %>
            <%= image_tag 'icon.png', class: 'h-8 w-auto object-contain' %>
          <% end %>
        <% else %>
          <%= link_to home_index_path, id: 'logo-top', class: 'inline-flex items-center' do %>
            <%= image_tag 'icon.png', class: 'h-8 w-auto object-contain' %>
          <% end %>
        <% end %>

        <button id="sidebar-close-btn" type="button"
                class="sm:hidden p-2 rounded-lg text-gray-400 hover:text-[#122029] hover:bg-gray-100">
          <span class="sr-only">Close sidebar</span>
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Nav -->
      <nav class="flex-1 overflow-y-auto px-3 py-5">
        <ul class="space-y-1">
          <% if session[:two_factor_authenticated] %>
            <p class="px-3 pb-2 text-[10px] font-semibold tracking-widest text-gray-400 uppercase">Workspace</p>

            <!-- Home Management -->
            <% if can?(:create, Home) %>
              <% active = current_page?(new_home_path) %>
              <%= link_to new_home_path do %>
                <li class="relative">
                  <div class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-colors <%= active ? 'bg-gray-50 text-[#122029] font-semibold' : 'text-[#5B6B76] hover:text-[#122029] hover:bg-gray-50' %>">
                    <% if active %><span class="absolute left-0 top-1.5 bottom-1.5 w-1 rounded-full bg-[#1FC8C4]"></span><% end %>
                    <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-[#1FC8C4]/12 text-[#0E9A96] shrink-0">
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25ZM6.75 12h.008v.008H6.75V12Zm0 3h.008v.008H6.75V15Zm0 3h.008v.008H6.75V18Z" />
                      </svg>
                    </span>
                    <span>Add Spreadsheets</span>
                  </div>
                </li>
              <% end %>
            <% end %>

            <!-- Reports & Analytics -->
            <% if can?(:read, Home) %>
              <% active = current_page?(new_home_url) %>
              <%= link_to new_home_url do %>
                <li class="relative">
                  <div class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-colors <%= active ? 'bg-gray-50 text-[#122029] font-semibold' : 'text-[#5B6B76] hover:text-[#122029] hover:bg-gray-50' %>">
                    <% if active %><span class="absolute left-0 top-1.5 bottom-1.5 w-1 rounded-full bg-[#FF7A59]"></span><% end %>
                    <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-[#FF7A59]/12 text-[#E15A3C] shrink-0">
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 14.25v2.25m3-4.5v4.5m3-6.75v6.75m3-9v9M6 20.25h12A2.25 2.25 0 0 0 20.25 18V6A2.25 2.25 0 0 0 18 3.75H6A2.25 2.25 0 0 0 3.75 6v12A2.25 2.25 0 0 0 6 20.25Z" />
                      </svg>
                    </span>
                    <span>Report and Analytics</span>
                  </div>
                </li>
              <% end %>
            <% end %>

            <!-- User Profile -->
            <% active = current_page?(user_path(current_user)) %>
            <%= link_to user_path(current_user) do %>
              <li class="relative">
                <div class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-colors <%= active ? 'bg-gray-50 text-[#122029] font-semibold' : 'text-[#5B6B76] hover:text-[#122029] hover:bg-gray-50' %>">
                  <% if active %><span class="absolute left-0 top-1.5 bottom-1.5 w-1 rounded-full bg-[#7C6FF0]"></span><% end %>
                  <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-[#7C6FF0]/12 text-[#5B4FD1] shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
                    </svg>
                  </span>
                  <span>User Profile</span>
                </div>
              </li>
            <% end %>

            <!-- Admin Only Sections -->
            <% if can?(:manage, :all) %>
              <p class="px-3 pt-5 pb-2 text-[10px] font-semibold tracking-widest text-gray-400 uppercase">Admin</p>

              <!-- Commission Settings -->
              <% active = current_page?(interest_rates_path) %>
              <%= link_to interest_rates_path do %>
                <li class="relative">
                  <div class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-colors <%= active ? 'bg-gray-50 text-[#122029] font-semibold' : 'text-[#5B6B76] hover:text-[#122029] hover:bg-gray-50' %>">
                    <% if active %><span class="absolute left-0 top-1.5 bottom-1.5 w-1 rounded-full bg-[#1FC8C4]"></span><% end %>
                    <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-[#1FC8C4]/12 text-[#0E9A96] shrink-0">
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 0 1 3 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 0 0-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 0 1-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 0 0 3 15h-.75M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm3 0h.008v.008H18V10.5Zm-12 0h.008v.008H6V10.5Z" />
                      </svg>
                    </span>
                    <span>Commission</span>
                  </div>
                </li>
              <% end %>

              <!-- Clients Management -->
              <% active = current_page?(clients_url) %>
              <%= link_to clients_url do %>
                <li class="relative">
                  <div class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-colors <%= active ? 'bg-gray-50 text-[#122029] font-semibold' : 'text-[#5B6B76] hover:text-[#122029] hover:bg-gray-50' %>">
                    <% if active %><span class="absolute left-0 top-1.5 bottom-1.5 w-1 rounded-full bg-[#FF7A59]"></span><% end %>
                    <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-[#FF7A59]/12 text-[#E15A3C] shrink-0">
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" />
                      </svg>
                    </span>
                    <span>Clients</span>
                  </div>
                </li>
              <% end %>

              <!-- Roles Management -->
              <% active = current_page?(roles_path) %>
              <%= link_to roles_path do %>
                <li class="relative">
                  <div class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-colors <%= active ? 'bg-gray-50 text-[#122029] font-semibold' : 'text-[#5B6B76] hover:text-[#122029] hover:bg-gray-50' %>">
                    <% if active %><span class="absolute left-0 top-1.5 bottom-1.5 w-1 rounded-full bg-[#7C6FF0]"></span><% end %>
                    <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-[#7C6FF0]/12 text-[#5B4FD1] shrink-0">
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 0 1-3.296-1.043 3.745 3.745 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 0 1 1.043-3.296 3.746 3.746 0 0 1 3.296-1.043A3.746 3.746 0 0 1 12 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 0 1 3.296 1.043 3.746 3.746 0 0 1 1.043 3.296A3.745 3.745 0 0 1 21 12Z" />
                      </svg>
                    </span>
                    <span>Roles</span>
                  </div>
                </li>
              <% end %>

              <!-- All Users -->
              <% active = current_page?(users_path) %>
              <%= link_to users_path do %>
                <li class="relative">
                  <div class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-colors <%= active ? 'bg-gray-50 text-[#122029] font-semibold' : 'text-[#5B6B76] hover:text-[#122029] hover:bg-gray-50' %>">
                    <% if active %><span class="absolute left-0 top-1.5 bottom-1.5 w-1 rounded-full bg-[#1FC8C4]"></span><% end %>
                    <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-[#1FC8C4]/12 text-[#0E9A96] shrink-0">
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
                      </svg>
                    </span>
                    <span>Show All Users</span>
                  </div>
                </li>
              <% end %>

              <!-- Transactions -->
              <% active = current_page?(transactions_path) %>
              <%= link_to transactions_path do %>
                <li class="relative">
                  <div class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-colors <%= active ? 'bg-gray-50 text-[#122029] font-semibold' : 'text-[#5B6B76] hover:text-[#122029] hover:bg-gray-50' %>">
                    <% if active %><span class="absolute left-0 top-1.5 bottom-1.5 w-1 rounded-full bg-[#FF7A59]"></span><% end %>
                    <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-[#FF7A59]/12 text-[#E15A3C] shrink-0">
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21 3 16.5m0 0L7.5 12M3 16.5h18M16.5 3 21 7.5m0 0L16.5 12M21 7.5H3" />
                      </svg>
                    </span>
                    <span>Transaction Status</span>
                  </div>
                </li>
              <% end %>

              <!-- Invite User -->
              <% active = current_page?(new_user_invitation_path) %>
              <%= link_to new_user_invitation_path do %>
                <li class="relative">
                  <div class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-colors <%= active ? 'bg-gray-50 text-[#122029] font-semibold' : 'text-[#5B6B76] hover:text-[#122029] hover:bg-gray-50' %>">
                    <% if active %><span class="absolute left-0 top-1.5 bottom-1.5 w-1 rounded-full bg-[#7C6FF0]"></span><% end %>
                    <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-[#7C6FF0]/12 text-[#5B4FD1] shrink-0">
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M18 7.5v3m0 0v3m0-3h3m-3 0h-3m-2.25-4.125a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0ZM3 19.235v-.11a6.375 6.375 0 0 1 12.75 0v.109A12.318 12.318 0 0 1 9.374 21c-2.331 0-4.512-.645-6.374-1.766Z" />
                      </svg>
                    </span>
                    <span>Invite User</span>
                  </div>
                </li>
              <% end %>
            <% end %>

            <!-- Admin & Account Manager Sections -->
            <% if can?(:manage, User) && cannot?(:manage, :all) %>
              <p class="px-3 pt-5 pb-2 text-[10px] font-semibold tracking-widest text-gray-400 uppercase">Admin</p>
              <% active = current_page?(users_path) %>
              <%= link_to users_path do %>
                <li class="relative">
                  <div class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-colors <%= active ? 'bg-gray-50 text-[#122029] font-semibold' : 'text-[#5B6B76] hover:text-[#122029] hover:bg-gray-50' %>">
                    <% if active %><span class="absolute left-0 top-1.5 bottom-1.5 w-1 rounded-full bg-[#1FC8C4]"></span><% end %>
                    <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-[#1FC8C4]/12 text-[#0E9A96] shrink-0">
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
                      </svg>
                    </span>
                    <span>Manage Users</span>
                  </div>
                </li>
              <% end %>
            <% end %>

            <!-- Auditor Sections -->
            <% if can?(:read, User) && cannot?([:manage, :create], User) %>
              <p class="px-3 pt-5 pb-2 text-[10px] font-semibold tracking-widest text-gray-400 uppercase">Account</p>
              <% active = current_page?(users_path) %>
              <%= link_to users_path do %>
                <li class="relative">
                  <div class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-colors <%= active ? 'bg-gray-50 text-[#122029] font-semibold' : 'text-[#5B6B76] hover:text-[#122029] hover:bg-gray-50' %>">
                    <% if active %><span class="absolute left-0 top-1.5 bottom-1.5 w-1 rounded-full bg-[#FF7A59]"></span><% end %>
                    <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-[#FF7A59]/12 text-[#E15A3C] shrink-0">
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178ZM15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                      </svg>
                    </span>
                    <span>View Users</span>
                  </div>
                </li>
              <% end %>
            <% end %>
          <% end %>
        </ul>
      </nav>

      <!-- Sign Out (pinned footer) -->
      <div class="shrink-0 border-t border-gray-100 p-3">
        <%= link_to destroy_user_session_path, method: :delete, data: { 'turbo_method': :delete, 'turbo-confirm': 'Are you sure?' } do %>
          <div class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-[#5B6B76] hover:text-[#122029] hover:bg-[#FB7185]/10 transition-colors group">
            <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-[#FB7185]/12 text-[#E11D48] shrink-0">
              <svg class="w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 18 16">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 8h11m0 0L8 4m4 4-4 4m4-11h3a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2h-3"/>
              </svg>
            </span>
            <span>Sign Out</span>
          </div>
        <% end %>
      </div>
    </div>
  </aside>

  <script>
      (function () {
          const toggleBtn = document.getElementById('sidebar-toggle-btn');
          const closeBtn = document.getElementById('sidebar-close-btn');
          const sidebar = document.getElementById('logo-sidebar');
          const backdrop = document.getElementById('sidebar-backdrop');

          function openSidebar() {
              sidebar.classList.remove('-translate-x-full');
              sidebar.classList.add('translate-x-0');
              backdrop.classList.remove('hidden');
              toggleBtn.setAttribute('aria-expanded', 'true');
          }

          function closeSidebar() {
              sidebar.classList.add('-translate-x-full');
              sidebar.classList.remove('translate-x-0');
              backdrop.classList.add('hidden');
              toggleBtn.setAttribute('aria-expanded', 'false');
          }

          if (toggleBtn && sidebar && backdrop) {
              toggleBtn.addEventListener('click', openSidebar);
              closeBtn && closeBtn.addEventListener('click', closeSidebar);
              backdrop.addEventListener('click', closeSidebar);

              window.addEventListener('resize', function () {
                  if (window.innerWidth >= 640) {
                      backdrop.classList.add('hidden');
                  }
              });
          }
      })();
  </script>
<% end %>
