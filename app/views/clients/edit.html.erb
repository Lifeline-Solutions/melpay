<div class="p-4 sm:ml-64 sm:mx-auto sm:mt-16 sm:px-6 lg:px-8 mx-auto">
<% if flash[:notice] %>
    <div class="mb-4 p-3 rounded bg-green-50 border border-green-200 text-green-800">
      <%= flash[:notice] %>
    </div>
  <% elsif flash[:alert] %>
    <div class="mb-4 p-3 rounded bg-red-50 border border-red-200 text-red-800">
      <%= flash[:alert] %>
    </div>
  <% end %>

  <h1 class="text-2xl font-semibold mb-4">Edit Client — <%= @client.name %></h1>

  <div class="bg-white p-6 rounded-lg shadow">
    <%= form_with model: @client, local: true do |f| %>
      <div class="grid grid-cols-1 gap-4">
        <div>
          <%= f.label :name, class: "block text-sm font-medium text-gray-700" %>
          <%= f.text_field :name, class: "mt-1 block w-full border rounded p-2" %>
        </div>

        <div>
          <%= f.label :email, class: "block text-sm font-medium text-gray-700" %>
          <%= f.email_field :email, class: "mt-1 block w-full border rounded p-2" %>
        </div>

        <div>
          <%= f.label :phone, class: "block text-sm font-medium text-gray-700" %>
          <%= f.text_field :phone, class: "mt-1 block w-full border rounded p-2" %>
        </div>

        <div>
          <%= f.label :credit, 'TOTAL CASH', class: "block text-sm font-medium text-gray-900 dark:text-gray-200 mb-2" %>
          <%= f.number_field :credit,
                             class: "mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm dark:bg-gray-700 dark:text-gray-100",
                             placeholder: 'e.g. Melpay Payments',
                             required: true %>
        </div>

        <!-- Commission Type Selection -->
        <div>
          <%= f.label :commission_type, "Commission Type", class: "block text-sm font-medium text-gray-700" %>
          <%= f.select :commission_type,
                options_for_select([
                  ['Use Global Default', ''],
                  ['Percentage', 'percentage'],
                  ['Fixed Amount', 'fixed']
                ], @client.commission_type),
                {},
                class: "mt-1 block w-full border rounded p-2",
                id: "client_commission_type" %>
          <p class="text-xs text-gray-500 mt-1">
            <% if @system_setting %>
              Global default: <%= @system_setting.commission_type.titleize %>
              (<%= @system_setting.percentage? ? "#{@system_setting.global_interest_rate}%" : number_to_currency(@system_setting.fixed_commission_amount) %>)
            <% else %>
              Global default: Percentage (2.0%)
            <% end %>
          </p>
        </div>

        <!-- Conditional Fields - Remove server-side visibility logic -->
        <div id="percentage-fields" class="hidden">
          <div>
            <%= f.label :custom_interest_rate, "Custom Interest Rate (%)", class: "block text-sm font-medium text-gray-700" %>
            <%= f.number_field :custom_interest_rate, step: 0.01, class: "mt-1 block w-40 border rounded p-2" %>
            <p class="text-xs text-gray-500 mt-1">
              Leave empty to use global default rate (<%= @system_setting&.global_interest_rate || 2.0 %>%).
            </p>
          </div>
        </div>

        <div id="fixed-fields" class="hidden">
          <div>
            <%= f.label :fixed_commission_amount, "Fixed Commission Amount", class: "block text-sm font-medium text-gray-700" %>
            <div class="flex items-center">
              <span class="mr-2 text-gray-600">$</span>
              <%= f.number_field :fixed_commission_amount, step: 0.01, class: "mt-1 block w-40 border rounded p-2" %>
            </div>
            <p class="text-xs text-gray-500 mt-1">
              Leave empty to use global fixed amount (<%= number_to_currency(@system_setting&.fixed_commission_amount) %>).
            </p>
          </div>
        </div>

        <div class="flex items-center gap-3 mt-4">
          <%= f.submit "Save Client", class: "px-4 py-2 bg-indigo-600 text-white rounded" %>

          <% if @client.commission_type.present? || @client.custom_interest_rate.present? %>
            <%= button_to "Reset to Global",
                  client_path(@client),
                  method: :patch,
                  params: { client: {
                    commission_type: nil,
                    custom_interest_rate: nil,
                    fixed_commission_amount: nil
                  } },
                  data: {
                    confirm: "Reset #{@client.name}'s commission to global default?",
                    turbo_confirm: "Reset #{@client.name}'s commission to global default?"
                  },
                  class: "px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 border border-gray-300 rounded-md hover:bg-gray-200 hover:text-gray-900 transition-colors duration-200" %>
          <% end %>

          <%= link_to "Back to Rates", interest_rates_path, class: "ml-auto text-sm text-gray-600 hover:underline" %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<script>
document.addEventListener('turbo:load', function() {
  const commissionTypeSelect = document.getElementById('client_commission_type');
  const percentageFields = document.getElementById('percentage-fields');
  const fixedFields = document.getElementById('fixed-fields');

  function toggleCommissionFields() {
    const selectedType = commissionTypeSelect.value;

    // Hide both fields first
    percentageFields.classList.add('hidden');
    fixedFields.classList.add('hidden');

    // Show the appropriate field based on selection
    if (selectedType === 'percentage') {
      percentageFields.classList.remove('hidden');
    } else if (selectedType === 'fixed') {
      fixedFields.classList.remove('hidden');
    }
    // If "Use Global Default" is selected, both fields remain hidden
  }

  if (commissionTypeSelect) {
    commissionTypeSelect.addEventListener('change', toggleCommissionFields);
    toggleCommissionFields(); // Set initial state
  }
});
</script>