<div class="p-6 bg-gray-50 dark:bg-gray-800 rounded-lg shadow mx-auto sm:ml-64 w-full">
  <h1 class="text-2xl font-bold mb-4">My Profile</h1>

  <% if can?(:read, @user) %>
    <div class="space-y-2">
      <p><strong>First Name:</strong> <%= @user&.first_name.presence || 'Not Present' %></p>
      <p><strong>Last Name:</strong> <%= @user&.last_name.presence || 'Not Present' %></p>
      <p><strong>Email:</strong> <%= @user&.email.presence || 'Not Present' %></p>
      <p><strong>Phone Number:</strong> <%= @user&.phone_number.presence || 'Not Present' %></p>
      <p><strong>Role(s):</strong> <%= @user.roles.distinct.pluck(:name).join(', ') %></p>
      <p><strong>Sign in Count:</strong> <%= @user.sign_in_count %></p>
      
      <% if can?(:read_sensitive_info, @user) || @user == current_user %>
        <p><strong>Current Sign in IP:</strong> <%= @user.current_sign_in_ip %></p>
        <p><strong>Last Sign in IP:</strong> <%= @user.last_sign_in_ip %></p>
        <p><strong>Last Sign in At:</strong> <%= @user.last_sign_in_at %></p>
        <p><strong>Confirmed At:</strong> <%= @user.confirmed_at %></p>
      <% end %>
      
      <p><strong>Created At:</strong> <%= @user.created_at.strftime("%B %d, %Y %H:%M") %></p>
      <p><strong>Updated At:</strong> <%= @user.updated_at.strftime("%B %d, %Y %H:%M") %></p>
    </div>

    <div class="mt-6 flex gap-3">
      <% if can?(:update, @user) %>
        <%= link_to "Edit Profile", edit_user_path(@user),
                    class: "px-4 py-2 bg-blue-600 text-white rounded" %>
      <% else %>
        <span class="px-4 py-2 bg-gray-400 text-white rounded cursor-not-allowed">Edit Profile</span>
      <% end %>

      <% if can?(:read, User) %>
        <%= link_to "Back to Users", users_path,
                    class: "px-4 py-2 bg-gray-600 text-white rounded" %>
      <% else %>
        <span class="px-4 py-2 bg-gray-400 text-white rounded cursor-not-allowed">Back to Users</span>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-8 text-gray-500 dark:text-gray-400">
      <p class="text-lg">You don't have permission to view this profile</p>
    </div>
  <% end %>
</div>