<div class="p-6 bg-gray-50 dark:bg-gray-800 rounded-lg shadow mx-auto sm:ml-64 w-full" >
  <h1 class="text-2xl font-bold mb-4">Edit Profile</h1>

  <%= form_with model: @user, local: true, class: "space-y-4" do |f| %>
    <div>
      <%= f.label :first_name, class: "block mb-1 font-medium" %>
      <%= f.text_field :first_name, class: "w-full border rounded p-2" %>
    </div>

    <div>
      <%= f.label :last_name, class: "block mb-1 font-medium" %>
      <%= f.text_field :last_name, class: "w-full border rounded p-2" %>
    </div>

    <div>
      <%= f.label :email, class: "block mb-1 font-medium" %>
      <%= f.email_field :email, class: "w-full border rounded p-2" %>
    </div>

    <div>
      <%= f.label :phone_number, class: "block mb-1 font-medium" %>
      <%= f.text_field :phone_number, class: "w-full border rounded p-2" %>
    </div>

    <div>
      <%= f.submit "Save Changes", class: "px-4 py-2 bg-green-600 text-white rounded" %>
    </div>
  <% end %>
</div>
