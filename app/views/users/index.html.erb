<div class="p-4 sm:ml-64 min-h-screen bg-white">
  <div class="max-w-6xl mx-auto">

    <!-- Page Header -->
    <div class="flex items-center justify-between mb-6 gap-3 flex-wrap">
      <div>
        <h1 class="text-2xl font-bold text-[#1C2B39]">Users List</h1>
        <p class="text-sm text-gray-500 mt-1">Manage user accounts and permissions</p>
      </div>
      <% if can?(:invite, User) %>
        <%= link_to new_user_invitation_path,
                    class: "inline-flex items-center gap-1.5 bg-[#2FACA6] hover:bg-[#228B7A] text-white text-sm font-semibold px-4 py-2.5 rounded-lg shadow-sm transition-colors" do %>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M18 7.5v3m0 0v3m0-3h3m-3 0h-3m-2.25-4.125a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zM3 19.235v-.11a6.375 6.375 0 0112.75 0v.109A12.318 12.318 0 019.374 21c-2.331 0-4.512-.645-6.374-1.766z" /></svg>
          Invite Users
        <% end %>
      <% end %>
    </div>

    <% if can?(:read, User) %>

      <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
        <table class="w-full users-table">
          <thead class="bg-[#1C2B39] hidden md:table-header-group">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-semibold text-white uppercase tracking-wider">User</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-white uppercase tracking-wider">Email</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-white uppercase tracking-wider">Phone</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-white uppercase tracking-wider">Sign in Count</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-white uppercase tracking-wider">Actions</th>
          </tr>
          </thead>
          <tbody class="block md:table-row-group divide-y divide-gray-100">
          <% @users.each do |user| %>
            <% initials = [user.first_name&.first, user.last_name&.first].compact.join.upcase %>
            <tr class="block md:table-row mb-4 md:mb-0 rounded-lg md:rounded-none border md:border-0 border-gray-100 shadow-sm md:shadow-none hover:bg-gray-50 transition-colors">
              <td data-label="User" class="users-cell px-4 py-2.5">
                <div class="flex items-center gap-3 md:justify-start justify-end">
                  <div class="w-8 h-8 rounded-full bg-[#1C2B39] flex items-center justify-center flex-shrink-0 order-2 md:order-1">
                    <span class="text-xs font-bold text-white"><%= initials.presence || "?" %></span>
                  </div>
                  <span class="text-sm font-semibold text-[#1C2B39] order-1 md:order-2">
                    <%= [user.first_name, user.last_name].compact.join(' ').presence || 'Unnamed' %>
                  </span>
                </div>
              </td>
              <td data-label="Email" class="users-cell px-4 py-2.5 text-gray-700 text-sm break-all"><%= user.email %></td>
              <td data-label="Phone" class="users-cell px-4 py-2.5 text-gray-700 text-sm"><%= user.phone_number.presence || '—' %></td>
              <td data-label="Sign in Count" class="users-cell px-4 py-2.5 text-gray-700 text-sm"><%= user.sign_in_count %></td>
              <td data-label="Actions" class="users-cell px-4 py-2.5">
                <div class="flex gap-3 md:justify-start justify-end">
                  <% if can?(:read, user) %>
                    <%= link_to 'Show', user_path(user), class: "text-[#2FACA6] hover:text-[#228B7A] text-sm font-semibold transition-colors" %>
                  <% else %>
                    <span class="text-gray-300 text-sm cursor-not-allowed">Show</span>
                  <% end %>

                  <% if can?(:update, user) %>
                    <%= link_to 'Edit', edit_user_path(user), class: "text-amber-600 hover:text-amber-700 text-sm font-semibold transition-colors" %>
                  <% else %>
                    <span class="text-gray-300 text-sm cursor-not-allowed">Edit</span>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
          </tbody>
        </table>
      </div>

      <% if @users.empty? %>
        <div class="text-center py-14 text-gray-400 bg-white rounded-xl border border-gray-100 mt-4">
          <svg class="w-10 h-10 mx-auto mb-3 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0112.75 0zM15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" /></svg>
          No users found
        </div>
      <% end %>

    <% else %>
      <div class="text-center py-12 text-gray-400 bg-white rounded-xl border border-gray-100">
        <p class="text-lg">You don't have permission to view users</p>
      </div>
    <% end %>

    <!-- Pagination -->
    <% if can?(:read, User) && @users.any? %>
      <nav class="mt-5 flex flex-wrap items-center justify-center sm:justify-between gap-3" aria-label="Pagination">
        <span class="text-sm text-gray-400 order-2 sm:order-1">Page <%= @page %> of <%= @total_pages %></span>

        <div class="flex gap-2 order-1 sm:order-2">
          <% if @page > 1 %>
            <%= link_to 'Previous',
                        users_path(page: @page - 1, query: params[:query], status: params[:status]),
                        class: 'px-4 py-2 rounded-lg border border-gray-200 bg-white hover:border-[#2FACA6] hover:text-[#2FACA6] text-sm font-medium text-gray-700 transition-colors' %>
          <% else %>
            <span class="px-4 py-2 rounded-lg border border-gray-200 text-gray-300 bg-white cursor-not-allowed text-sm font-medium">Previous</span>
          <% end %>

          <% if @page < @total_pages %>
            <%= link_to 'Next',
                        users_path(page: @page + 1, query: params[:query], status: params[:status]),
                        class: 'px-4 py-2 rounded-lg bg-[#2FACA6] hover:bg-[#228B7A] text-white text-sm font-semibold transition-colors' %>
          <% else %>
            <span class="px-4 py-2 rounded-lg bg-gray-200 text-gray-400 cursor-not-allowed text-sm font-semibold">Next</span>
          <% end %>
        </div>
      </nav>
    <% end %>

  </div>
</div>

<style>
    @media (max-width: 767px) {
        .users-table tbody { display: block; }
        .users-table tr { display: block; padding: 0.5rem 0; }
        .users-table td.users-cell {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border: none;
        }
        .users-table td.users-cell::before {
            content: attr(data-label);
            font-size: 0.7rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.03em;
            color: #6b7280;
            padding-right: 1rem;
        }
    }
</style>