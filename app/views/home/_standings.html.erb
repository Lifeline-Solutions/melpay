<div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4 mb-4">

  <!-- Money In -->
  <div class="flex items-center justify-between rounded-2xl bg-white border border-gray-100 shadow-sm hover:shadow-md transition-shadow p-4 sm:p-5">
    <div class="flex flex-col">
      <% client = @home&.client || current_user&.client %>
      <% if can?(:read, Client) && client %>
        <span class="text-xl sm:text-2xl font-semibold text-[#122029]"><%= number_to_currency(client&.credit || 0) %></span>
      <% else %>
        <span class="text-xl sm:text-2xl font-semibold text-[#122029]"><%= number_to_currency(0) %></span>
      <% end %>
      <span class="text-sm text-[#5B6B76] mt-0.5">Money In</span>
    </div>
    <div class="flex items-center justify-center w-11 h-11 sm:w-12 sm:h-12 rounded-xl bg-[#1FC8C4]/12 text-[#0E9A96] shrink-0">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="w-5 h-5 sm:w-6 sm:h-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m0-15 5.25 5.25M12 4.5 6.75 9.75" />
      </svg>
    </div>
  </div>

  <!-- Money Out -->
  <div class="flex items-center justify-between rounded-2xl bg-white border border-gray-100 shadow-sm hover:shadow-md transition-shadow p-4 sm:p-5">
    <div class="flex flex-col">
      <% if can?(:read, Transaction) %>
        <%
          transaction_scope = Transaction.where(status: 'success', is_latest: true)
          unless current_user.has_role?(:super_admin)
            transaction_scope = transaction_scope.where(client_id: current_user.client_id)
          end
          successful_transactions_total = transaction_scope.sum(:total_cost)
        %>
        <span class="text-xl sm:text-2xl font-semibold text-[#122029]"><%= number_to_currency(successful_transactions_total || 0) %></span>
      <% else %>
        <span class="text-xl sm:text-2xl font-semibold text-[#122029]"><%= number_to_currency(0) %></span>
      <% end %>
      <span class="text-sm text-[#5B6B76] mt-0.5">Money Out</span>
    </div>
    <div class="flex items-center justify-center w-11 h-11 sm:w-12 sm:h-12 rounded-xl bg-[#FF7A59]/12 text-[#E15A3C] shrink-0">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="w-5 h-5 sm:w-6 sm:h-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 19.5v-15m0 15-5.25-5.25M12 19.5l5.25-5.25" />
      </svg>
    </div>
  </div>

  <!-- Total Transactions -->
  <div class="flex items-center justify-between rounded-2xl bg-white border border-gray-100 shadow-sm hover:shadow-md transition-shadow p-4 sm:p-5">
    <div class="flex flex-col">
      <% if can?(:read, Transaction) %>
        <%
          transaction_scope = Transaction.where(status: 'success', is_latest: true)
          unless current_user.has_role?(:super_admin)
            transaction_scope = transaction_scope.where(client_id: current_user.client_id)
          end
          successful_transactions_count = transaction_scope.count
        %>
        <span class="text-xl sm:text-2xl font-semibold text-[#122029]"><%= successful_transactions_count %></span>
      <% else %>
        <span class="text-xl sm:text-2xl font-semibold text-[#122029]">0</span>
      <% end %>
      <span class="text-sm text-[#5B6B76] mt-0.5">Total Transactions</span>
    </div>
    <div class="flex items-center justify-center w-11 h-11 sm:w-12 sm:h-12 rounded-xl bg-[#7C6FF0]/12 text-[#5B4FD1] shrink-0">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="w-5 h-5 sm:w-6 sm:h-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21 3 16.5m0 0L7.5 12M3 16.5h18M16.5 3 21 7.5m0 0L16.5 12M21 7.5H3" />
      </svg>
    </div>
  </div>
</div>
