<div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4 mb-4">
  <div class="flex items-center justify-between h-20 sm:h-24 rounded-sm bg-gray-50 dark:bg-gray-800 p-3 sm:p-4">
    <div class="text-lg sm:text-xl flex flex-col p-1 sm:p-2">
      <% client = @home&.client || current_user&.client %>
      <% if can?(:read, Client) && client %>
        <span><%= number_to_currency(client&.credit || 0) %></span>
        <span class="text-sm sm:text-base">Money In</span>
      <% else %>
        <span><%= number_to_currency(0) %></span>
        <span class="text-sm sm:text-base">Money In</span>
      <% end %>
    </div>
    <div>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5 sm:size-6 shrink-0">
        <path d="M7.5 3.375c0-1.036.84-1.875 1.875-1.875h.375a3.75 3.75 0 0 1 3.75 3.75v1.875C13.5 8.161 14.34 9 15.375 9h1.875A3.75 3.75 0 0 1 21 12.75v3.375C21 17.16 20.16 18 19.125 18h-9.75A1.875 1.875 0 0 1 7.5 16.125V3.375Z" />
        <path d="M15 5.25a5.23 5.23 0 0 0-1.279-3.434 9.768 9.768 0 0 1 6.963 6.963A5.23 5.23 0 0 0 17.25 7.5h-1.875A.375.375 0 0 1 15 7.125V5.25ZM4.875 6H6v10.125A3.375 3.375 0 0 0 9.375 19.5H16.5v1.125c0 1.035-.84 1.875-1.875 1.875h-9.75A1.875 1.875 0 0 1 3 20.625V7.875C3 6.839 3.84 6 4.875 6Z" />
      </svg>
    </div>
  </div>

  <div class="flex items-center justify-between h-20 sm:h-24 rounded-sm bg-gray-50 dark:bg-gray-800 p-3 sm:p-4">
    <div class="text-lg sm:text-xl flex flex-col p-1 sm:p-2">
      <% if can?(:read, Transaction) %>
        <%
          transaction_scope = Transaction.where(status: 'success', is_latest: true)
          unless current_user.has_role?(:super_admin)
            transaction_scope = transaction_scope.where(client_id: current_user.client_id)
          end
          successful_transactions_total = transaction_scope.sum(:total_cost)
        %>
        <span><%= number_to_currency(successful_transactions_total || 0) %></span>
      <% else %>
        <span><%= number_to_currency(0) %></span>
      <% end %>
      <span class="text-sm sm:text-base">Money Out</span>
    </div>
    <div>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5 sm:size-6 shrink-0">
        <path d="M7.5 3.375c0-1.036.84-1.875 1.875-1.875h.375a3.75 3.75 0 0 1 3.75 3.75v1.875C13.5 8.161 14.34 9 15.375 9h1.875A3.75 3.75 0 0 1 21 12.75v3.375C21 17.16 20.16 18 19.125 18h-9.75A1.875 1.875 0 0 1 7.5 16.125V3.375Z" />
        <path d="M15 5.25a5.23 5.23 0 0 0-1.279-3.434 9.768 9.768 0 0 1 6.963 6.963A5.23 5.23 0 0 0 17.25 7.5h-1.875A.375.375 0 0 1 15 7.125V5.25ZM4.875 6H6v10.125A3.375 3.375 0 0 0 9.375 19.5H16.5v1.125c0 1.035-.84 1.875-1.875 1.875h-9.75A1.875 1.875 0 0 1 3 20.625V7.875C3 6.839 3.84 6 4.875 6Z" />
      </svg>
    </div>
  </div>

  <div class="flex items-center justify-between h-20 sm:h-24 rounded-sm bg-gray-50 dark:bg-gray-800 p-3 sm:p-4">
    <div class="text-lg sm:text-xl flex flex-col p-1 sm:p-2">
      <% if can?(:read, Transaction) %>
        <%
          transaction_scope = Transaction.where(status: 'success', is_latest: true)
          unless current_user.has_role?(:super_admin)
            transaction_scope = transaction_scope.where(client_id: current_user.client_id)
          end
          successful_transactions_count = transaction_scope.count
        %>
        <span><%= successful_transactions_count %></span>
      <% else %>
        <span>0</span>
      <% end %>
      <span class="text-sm sm:text-base">Total Transactions</span>
    </div>
    <div>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5 sm:size-6 shrink-0">
        <path d="M7.5 3.375c0-1.036.84-1.875 1.875-1.875h.375a3.75 3.75 0 0 1 3.75 3.75v1.875C13.5 8.161 14.34 9 15.375 9h1.875A3.75 3.75 0 0 1 21 12.75v3.375C21 17.16 20.16 18 19.125 18h-9.75A1.875 1.875 0 0 1 7.5 16.125V3.375Z" />
        <path d="M15 5.25a5.23 5.23 0 0 0-1.279-3.434 9.768 9.768 0 0 1 6.963 6.963A5.23 5.23 0 0 0 17.25 7.5h-1.875A.375.375 0 0 1 15 7.125V5.25ZM4.875 6H6v10.125A3.375 3.375 0 0 0 9.375 19.5H16.5v1.125c0 1.035-.84 1.875-1.875 1.875h-9.75A1.875 1.875 0 0 1 3 20.625V7.875C3 6.839 3.84 6 4.875 6Z" />
      </svg>
    </div>
  </div>
</div>