<div class="container mx-auto px-4 py-8 p-4  ml-64 w-full h-screen">
  <!-- Summary Cards -->
  <div class="grid grid-cols-1 md:grid-cols-5 gap-4 mb-8">
    <div class="bg-green-100 p-6 rounded-lg shadow">
      <h3 class="text-sm font-semibold text-green-800">Current Balance</h3>
      <p class="text-2xl font-bold text-green-600"><%= number_to_currency(@total_deposits) %></p>
    </div>
    <div class="bg-green-100 p-6 rounded-lg shadow">
      <h3 class="text-sm font-semibold text-green-800">Total Amount to transfer</h3>
      <p class="text-2xl font-bold text-green-600"><%= number_to_currency(@total_deposits) %></p>
      <span class="text-xs text-green-600">Global ID: <%= @home.unique_id %></span>
    </div>
    <div class="bg-yellow-100 p-6 rounded-lg shadow">
      <h3 class="text-sm font-semibold text-yellow-800">Total Deposit Count</h3>
      <p class="text-2xl font-bold text-yellow-600"><%= @total_deposit_count %></p>
    </div>
    <div class="bg-yellow-100 p-6 rounded-lg shadow">
      <h3 class="text-sm font-semibold text-yellow-800">Transaction Cost</h3>
      <p class="text-2xl font-bold text-yellow-600"><%=  number_to_currency(@deposit_interest) %></p>
    </div>
    <div class="bg-blue-100 p-6 rounded-lg shadow">
      <h3 class="text-sm font-semibold text-blue-800">Total Cost</h3>
      <p class="text-2xl font-bold text-blue-600"><%= number_to_currency(@total_cost) %></p>
    </div>
  </div>
  <!-- Deposits Table -->
  <div class="mb-8">
    <h2 class="text-xl font-bold mb-4">Deposits</h2>

    <!-- Global Payment Buttons -->
    <% has_pending_deposits = @deposits.any? { |d| d['status'].to_s.strip.downcase != 'success' } %>
    <% if has_pending_deposits %>
      <div class="mb-4 flex gap-2">
        <%= button_to "Pay All Deposits (Success)", pay_all_deposits_home_path(@home, status: 'success'), method: :post, class: "bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-4 rounded", data: { confirm: 'Are you sure you want to mark all deposits as successful?' } %>
      </div>
    <% else %>
      <div class="mb-4">
        <span class="inline-block bg-green-100 text-green-800 text-sm font-semibold px-4 py-2 rounded">
          ✓ All deposits have been processed successfully
        </span>
      </div>
    <% end %>

    <div class="overflow-x-auto">
      <% client = @home.client || current_user.client %>
      <% interest_rate = client&.applied_interest_rate.to_f %>
      <table class="min-w-full bg-white dark:bg-gray-700 rounded-lg shadow">
        <thead class="bg-gray-200 dark:bg-gray-800">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">Transaction ID</th>
          <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">Date</th>
          <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">Amount</th>
          <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">Transaction Cost</th>
          <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">Percentage</th>
          <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">Total Cost</th>
          <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">Status</th>
          <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">Type</th>
          <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">Actions</th>
          <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">Description</th>
        </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
        <% @deposits.each do |deposit| %>
          <% deposit_amount = deposit['amount'].to_f %>
          <% transaction_cost = deposit_amount * (interest_rate / 100.0) %>
          <% total_cost = deposit_amount + transaction_cost %>
          <% current_status = deposit['status'].to_s.strip %>
          <% is_successful = current_status.downcase == 'success' %>
          <tr>
            <td class="px-6 py-3 whitespace-nowrap font-mono text-sm font-semibold text-gray-900">
              <%= deposit['transaction_id'] %>
            </td>
            <td class="px-6 py-3 whitespace-nowrap">
              <%= deposit['date'].present? ? (deposit['date'].is_a?(Date) ? deposit['date'] : Date.parse(deposit['date'])).strftime("%B %d, %Y") : 'N/A' %>
            </td>
            <td class="px-6 py-3 text-green-600 font-semibold">
              <%= number_to_currency(deposit_amount) %>
            </td>
            <td class="px-6 py-3 text-yellow-600 font-semibold">
              <%= number_to_currency(transaction_cost) %>
            </td>
            <td class="px-6 py-3">
              <%= number_to_percentage(interest_rate, precision: 2) %>
            </td>
            <td class="px-6 py-3 text-blue-600 font-semibold">
              <%= number_to_currency(total_cost) %>
            </td>
            <td class="px-6 py-3">
              <% if current_status.present? %>
                <span class="px-2 py-1 text-xs font-semibold rounded-full <%= current_status.downcase == 'success' ? 'bg-green-100 text-green-800' : current_status.downcase == 'pending' ? 'bg-yellow-100 text-yellow-800' : current_status.downcase == 'failed' ? 'bg-red-100 text-red-800' : 'bg-gray-100 text-gray-800' %>">
                  <%= current_status.capitalize %>
                </span>
              <% else %>
                <span class="px-2 py-1 text-xs font-semibold rounded-full bg-gray-100 text-gray-800">Pending</span>
              <% end %>
            </td>
            <td class="px-6 py-3">
              <%= deposit['type']&.capitalize || 'N/A' %>
            </td>
            <td class="px-6 py-3">
              <% if is_successful %>
                <span class="text-xs text-gray-500">Completed</span>
              <% else %>
                <div class="flex gap-1">
                  <%= button_to "✓", pay_single_deposit_home_path(@home, deposit_transaction_id: deposit['transaction_id'], status: 'success'), method: :post, class: "bg-green-500 hover:bg-green-600 text-white text-xs font-bold py-1 px-2 rounded", title: "Mark as Success", data: { confirm: 'Mark this payment as successful?' } %>
                  <%= button_to "✗", pay_single_deposit_home_path(@home, deposit_transaction_id: deposit['transaction_id'], status: 'failed'), method: :post, class: "bg-red-500 hover:bg-red-600 text-white text-xs font-bold py-1 px-2 rounded", title: "Mark as Failed", data: { confirm: 'Mark this payment as failed?' } %>
                </div>
              <% end %>
            </td>
            <td class="px-6 py-3">
              <%= deposit['description'] || 'N/A' %>
            </td>
          </tr>
        <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
