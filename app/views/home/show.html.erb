<div class="container mx-auto px-4 py-8 p-4  ml-64 w-full h-screen">
  <!-- Summary Cards -->
  <div class="grid grid-cols-1 md:grid-cols-5 gap-4 mb-8">
    <div class="bg-green-100 p-6 rounded-lg shadow">
      <h3 class="text-sm font-semibold text-green-800">Current Balance</h3>
      <p class="text-2xl font-bold text-green-600"><%= number_to_currency(@total_deposits) %></p>
    </div>
    <div class="bg-green-100 p-6 rounded-lg shadow">
      <h3 class="text-sm font-semibold text-green-800">Total Amount to transfer</h3>
      <p class="text-2xl font-bold text-green-600"><%= number_to_currency(@total_deposits) %></p>
    </div>
    <div class="bg-yellow-100 p-6 rounded-lg shadow">
      <h3 class="text-sm font-semibold text-yellow-800">Total Deposit Count</h3>
      <p class="text-2xl font-bold text-yellow-600"><%= @total_deposit_count %></p>
    </div>
    <div class="bg-yellow-100 p-6 rounded-lg shadow">
      <h3 class="text-sm font-semibold text-yellow-800">Transaction Cost</h3>
      <p class="text-2xl font-bold text-yellow-600"><%=  number_to_currency(@deposit_interest) %></p>
    </div>

    <div class="bg-blue-100 p-6 rounded-lg shadow">
      <h3 class="text-sm font-semibold text-blue-800">Total Cost</h3>
      <p class="text-2xl font-bold text-blue-600"><%= number_to_currency(@total_cost) %></p>
    </div>
  </div>

  <!-- Deposits Table -->
  <div class="mb-8">
    <h2 class="text-xl font-bold mb-4">Deposits</h2>
    <div class="overflow-x-auto">
      <table class="min-w-full bg-white dark:bg-gray-700 rounded-lg shadow">
        <thead class="bg-gray-200 dark:bg-gray-800">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">Date</th>
          <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">Description</th>
          <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">Amount</th>
          <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">Type</th>
        </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
        <% @deposits.each do |deposit| %>
          <tr>
            <td class="px-6 py-4 whitespace-nowrap">
              <%= deposit['date'].present? ? (deposit['date'].is_a?(Date) ? deposit['date'] : Date.parse(deposit['date'])).strftime("%B %d, %Y") : 'N/A' %>
            </td>
            <td class="px-6 py-4"><%= deposit['description'] %></td>

            <td class="px-6 py-4 text-green-600 font-semibold"><%= number_to_currency(deposit['amount']) %></td>
            <td class="px-6 py-4"><%= deposit['type'] %></td>
          </tr>
        <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>