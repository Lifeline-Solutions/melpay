<div class="p-6">
  <h1 class="text-2xl font-bold text-gray-800 dark:text-gray-100 mb-4">Uploaded Spreadsheets</h1>

  <%= render "home/home_index_topbar" %>

  <div class="bg-white dark:bg-gray-800 shadow rounded-lg overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
      <thead class="bg-gray-50 dark:bg-gray-700">
        <tr>
          <th class="px-6 py-3 text-left text-sm font-semibold text-gray-600 dark:text-gray-200">Date Of Upload</th>
          <th class="px-6 py-3 text-left text-sm font-semibold text-gray-600 dark:text-gray-200">Global ID</th>
          <th class="px-6 py-3 text-left text-sm font-semibold text-gray-600 dark:text-gray-200">Document Name</th>
          <th class="px-6 py-3 text-left text-sm font-semibold text-gray-600 dark:text-gray-200">Total Deposits</th>
          <th class="px-6 py-3 text-left text-sm font-semibold text-gray-600 dark:text-gray-200">Successful Transactions</th>
          <th class="px-6 py-3 text-left text-sm font-semibold text-gray-600 dark:text-gray-200">Cost Of Transaction</th>

          <th class="px-6 py-3">VIEW</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
        <% @homes.each do |home| %>
          <tr class="hover:bg-gray-50 dark:hover:bg-gray-700">
            <td class="px-6 py-4 text-sm font-medium whitespace-nowrap">
              <%= home.created_at.strftime("%I:%M %p - %B %d, %Y") %>
            </td>
            <td class="px-6 py-4">
              <%= home.unique_id %>
            </td>
            <td class="px-6 py-4">
              <%= home.name.presence || home.document.filename.to_s %>
            </td>
            <td class="px-6 py-4 text-center">
              <%= number_to_currency(@totals_deposits[home.id] || 0) %>
            </td>
            <td class="px-6 py-4 text-center">
              <div class="flex items-center justify-center gap-2">
                <span class="inline-flex items-center px-3 py-1 rounded-lg text-sm font-semibold bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200">
                  <%= @successful_transactions_count[home.id] || 0 %>
                </span>
                <span class="text-gray-500 dark:text-gray-400 font-medium">/</span>
                <span class="inline-flex items-center px-3 py-1 rounded-lg text-sm font-semibold bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-200">
                  <%= @total_deposit_count[home.id] || 0 %>
                </span>
              </div>
            </td>
            <td class="px-6 py-4 text-center">
              <%= number_to_currency(@deposit_interest[home.id] || 0) %>
            </td>
            <td class="px-6 py-4 text-center">
              <%= link_to "View", home_path(home), class: "text-blue-600 dark:text-blue-400 hover:underline" %>
            </td>
          </tr>
        <% end %>
      </tbody>

      <!-- Totals row -->
      <tfoot class="bg-gray-100 dark:bg-gray-700">
        <tr>
          <td class="px-6 py-3 font-semibold text-gray-800 dark:text-gray-200"></td>
          <td class="px-6 py-3 font-semibold text-gray-800 dark:text-gray-200"></td>
          <td class="px-6 py-3 font-semibold text-gray-800 dark:text-gray-200">Grand Totals</td>
          <td class="px-6 py-3 font-semibold text-center">
            <%= number_to_currency(@total_deposits_sum || 0) %>
          </td>
          <td class="px-6 py-3 font-semibold text-center">
            <div class="flex items-center justify-center gap-2">
              <span class="inline-flex items-center px-3 py-1 rounded-lg text-sm font-bold bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200">
                <%= @successful_transactions_count.values.sum || 0 %>
              </span>
              <span class="text-gray-600 dark:text-gray-400 font-bold">/</span>
              <span class="inline-flex items-center px-3 py-1 rounded-lg text-sm font-bold bg-gray-200 text-gray-800 dark:bg-gray-600 dark:text-gray-200">
                <%= @total_deposit_count.values.sum || 0 %>
              </span>
            </div>
          </td>
          <td class="px-6 py-3 font-semibold text-center">
            <%= number_to_currency(@deposit_interest.values.sum || 0) %>
          </td>
        </tr>
      </tfoot>
    </table>
  </div>

  <div class="flex gap-10 mt-5">
    <!-- Pagination Controls -->
    <div class="pagination">
      <% if @page > 1 %>
        <%= link_to 'Previous',
                    home_index_path(page: @page - 1, query: params[:query], status: params[:status]),
                    class: 'mb-4 h-12 bg-[#3F8CFF] hover:bg-[#3A81EB] p-3 rounded font-bold rounded-lg text-slate-100' %>
      <% end %>

      <span>Page <%= @page %> of <%= @total_pages %></span>

      <% if @page < @total_pages %>
        <%= link_to 'Next',
                    home_index_path(page: @page + 1, query: params[:query], status: params[:status]),
                    class: 'mb-4 h-12 bg-[#3F8CFF] hover:bg-[#3A81EB] p-3 rounded font-bold rounded-lg text-slate-100' %>
      <% end %>
    </div>
  </div>
</div>
