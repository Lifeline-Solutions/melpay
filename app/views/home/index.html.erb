<div class="relative sm:ml-64 min-h-screen bg-white overflow-hidden">

  <!-- soft brand blobs, fixed to the viewport so they stay put while content scrolls -->
  <div class="pointer-events-none fixed -top-24 -left-16 w-80 h-80 rounded-full bg-[#1FC8C4]/8 blur-3xl"></div>
  <div class="pointer-events-none fixed top-1/3 -right-24 w-96 h-96 rounded-full bg-[#7C6FF0]/6 blur-3xl"></div>
  <div class="pointer-events-none fixed bottom-0 left-1/4 w-80 h-80 rounded-full bg-[#FF7A59]/6 blur-3xl"></div>

  <div class="relative p-4 sm:p-6 space-y-4">
    <%= render "home/standings" %>
    <%= render "home/stastics_and_account" %>
    <%= render "home/recent_transaction_and_success" %>

    <!-- Spreadsheets Table -->
    <%= render "home/homes" %>
  </div>
</div>
