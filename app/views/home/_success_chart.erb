<div class="rounded-2xl bg-white border border-gray-100 shadow-sm h-full p-4 sm:p-5">
  <h3 class="text-base sm:text-lg font-semibold text-[#122029] text-center mb-3">Transaction Success Rate</h3>
  <div class="w-full max-w-xs mx-auto">
    <% if can?(:read, Transaction) %>
      <%= pie_chart(
            [["Success", @success_count || 0], ["Failed", @failed_count || 0]],
            donut: true,
            colors: ["#1FC8C4", "#FB7185"],
            legend: "top",
            suffix: " transactions"
          ) %>
    <% else %>
      <div class="flex items-center justify-center h-48">
        <p class="text-[#5B6B76] text-center">No permission to view transaction data</p>
      </div>
    <% end %>
  </div>
</div>
