<div class="items-center justify-center rounded-sm bg-gray-50 dark:bg-gray-800 shadow h-full p-4">
    <h3 class="text-lg font-semibold mb-3 text-gray-800 dark:text-gray-100 text-center">Transaction Success Rate</h3>
    <div class="w-full max-w-xs mx-auto">
      <%= pie_chart(
        [["Success", @success_count || 0], ["Failed", @failed_count || 0]],
        donut: true,
        colors: ["#10B981", "#EF4444"],
        legend: "top",
        suffix: " transactions"
      ) %>
    </div>
</div>