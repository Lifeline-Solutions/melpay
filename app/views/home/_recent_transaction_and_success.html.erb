<div class="grid grid-cols-1 lg:grid-cols-7 gap-4 mb-4 items-stretch">
  <!-- Left side -->
  <div class="lg:col-span-5">
    <% if can?(:read, Home) %>
      <%= render partial: "home/transactions_show" %>
    <% else %>
      <div class="flex items-center justify-center h-40 sm:h-full bg-white border border-gray-100 rounded-2xl">
        <p class="text-[#5B6B76]">No access to view transactions</p>
      </div>
    <% end %>
  </div>

  <!-- Right side -->
  <div class="lg:col-span-2">
    <% if can?(:read, Transaction) %>
      <%= render partial: "home/success_chart" %>
    <% else %>
      <div class="flex items-center justify-center h-40 sm:h-full bg-white border border-gray-100 rounded-2xl">
        <p class="text-[#5B6B76]">No access to view charts</p>
      </div>
    <% end %>
  </div>
</div>
