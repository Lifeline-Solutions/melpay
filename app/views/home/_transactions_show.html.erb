<div class="rounded-2xl bg-white border border-gray-100 shadow-sm p-4 sm:p-5 h-full flex flex-col">
  <h2 class="text-base sm:text-lg font-semibold text-[#122029] mb-3">
    Recent Transactions
  </h2>
  <div class="overflow-x-auto flex-grow">
    <table class="min-w-full text-sm">
      <thead>
      <tr class="border-b border-gray-100">
        <th class="px-4 py-2.5 text-left font-semibold text-xs uppercase tracking-wide text-gray-400">Date</th>
        <th class="px-4 py-2.5 text-left font-semibold text-xs uppercase tracking-wide text-gray-400">Transaction ID</th>
        <th class="px-4 py-2.5 text-left font-semibold text-xs uppercase tracking-wide text-gray-400">Commission</th>
        <th class="px-4 py-2.5 text-left font-semibold text-xs uppercase tracking-wide text-gray-400">Amount</th>
        <th class="px-4 py-2.5 text-left font-semibold text-xs uppercase tracking-wide text-gray-400">Cost of Transaction</th>
        <th class="px-4 py-2.5 text-left font-semibold text-xs uppercase tracking-wide text-gray-400">Total Cost</th>
        <th class="px-4 py-2.5 text-left font-semibold text-xs uppercase tracking-wide text-gray-400">Success</th>
      </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
      <% if can?(:read, Transaction) %>
        <% @recent_deposits.each do |deposit| %>
          <tr class="hover:bg-gray-50 transition-colors">
            <td class="px-4 py-3 text-left whitespace-nowrap text-[#5B6B76]">
              <% date_val =
                   if deposit[:date].is_a?(String)
                     begin
                       DateTime.parse(deposit[:date])
                     rescue
                       Time.zone.now
                     end
                   else
                     deposit[:date]
                   end
              %>
              <%= date_val.strftime("%I:%M %p - %B %d, %Y") %>
            </td>
            <td class="px-4 py-3 whitespace-nowrap text-left text-[#5B6B76]">
              <%= deposit[:transaction_id].presence || 'N/A' %>
            </td>
            <td class="px-4 py-3 text-left text-[#5B4FD1] font-semibold">
              <%= number_to_percentage(deposit[:interest_rate].to_f, precision: 2) %>
            </td>
            <td class="px-4 py-3 text-left text-[#0E9A96] font-semibold">
              <%= number_to_currency(deposit[:amount].to_f) %>
            </td>
            <td class="px-4 py-3 text-left text-[#E15A3C] font-semibold">
              <%= number_to_currency(deposit[:transaction_cost].to_f) %>
            </td>
            <td class="px-4 py-3 text-left text-[#122029] font-semibold">
              <%= number_to_currency(deposit[:total_cost].to_f) %>
            </td>
            <td class="px-4 py-3 text-left">
              <% current_status = deposit[:status].to_s.strip %>
              <% if current_status.present? %>
                  <span class="px-2.5 py-1 text-xs font-semibold rounded-full <%= current_status.downcase == 'success' ? 'bg-[#1FC8C4]/12 text-[#0E9A96]' : current_status.downcase == 'pending' ? 'bg-amber-100 text-amber-700' : current_status.downcase == 'failed' ? 'bg-[#FB7185]/12 text-[#E11D48]' : 'bg-gray-100 text-gray-600' %>">
                    <%= current_status.capitalize %>
                  </span>
              <% else %>
                <span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-amber-100 text-amber-700">Pending</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      <% else %>
        <tr>
          <td colspan="7" class="px-4 py-8 text-center text-[#5B6B76]">
            No permission to view transactions
          </td>
        </tr>
      <% end %>
      </tbody>
    </table>
  </div>

  <!-- Button -->
  <div class="mt-4 flex justify-end">
    <% if can?(:read, Transaction) %>
      <%= link_to "View All Transactions", transactions_path,
                  class: "px-4 py-2 bg-[#122029] hover:bg-[#1FC8C4] text-white text-sm font-medium rounded-lg transition-colors" %>
    <% else %>
      <span class="px-4 py-2 bg-gray-200 text-gray-400 text-sm font-medium rounded-lg cursor-not-allowed">View All Transactions</span>
    <% end %>
  </div>
</div>
