<div class="p-4 sm:ml-64 sm:mx-auto bg-white dark:bg-gray-800 shadow-lg rounded-xl overflow-hidden">
  <div class="grid grid-cols-1 p-4">

    <!-- Left: Form -->
    <div class="p-5 sm:p-8 flex flex-col justify-center">
      <h2 class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white mb-2">
        Upload Your Document
      </h2>
      <p class="text-sm text-gray-600 dark:text-gray-400 mb-6">
        Give your file a name and upload a spreadsheet (.xlsx or .csv). This will be saved and available in your documents list.
      </p>

      <%= form_with model: @home, url: home_index_url, method: :post, local: true, data: { turbo: false }, html: { class: "space-y-5 sm:space-y-6" } do |f| %>

        <!-- Document Name -->
        <div>
          <%= f.label :name, 'Document Name', class: "block text-sm font-medium text-gray-900 dark:text-gray-200 mb-2" %>
          <%= f.text_field :name,
                           class: "w-full rounded-md border-gray-300 dark:border-gray-600 shadow-sm focus:border-indigo-500 focus:ring focus:ring-indigo-200 focus:ring-opacity-50 dark:bg-gray-700 dark:text-gray-100 placeholder-gray-400 text-base sm:text-sm",
                           placeholder: 'e.g. Melpay Payments',
                           required: true %>
        </div>

        <!-- File Upload -->
        <div>
          <%= f.label :document, 'Upload File', class: "block text-sm font-medium text-gray-900 dark:text-gray-200 mb-2" %>
          <%= f.file_field :document,
                           class: "w-full cursor-pointer text-sm text-gray-700 dark:text-gray-100 file:mr-3 sm:file:mr-4 file:py-2 file:px-3 sm:file:px-4
                        file:rounded-md file:border-0
                        file:text-sm file:font-semibold
                        file:bg-indigo-600 file:text-white
                        hover:file:bg-indigo-700
                        dark:file:bg-indigo-500 dark:hover:file:bg-indigo-600
                        border border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:outline-none",
                           accept: ".xlsx,.csv" %>
          <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Only .xlsx or .csv files are supported</p>
        </div>

        <!-- Submit Button -->
        <div>
          <%= f.submit 'Upload Document',
                       class: "w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 border border-transparent text-sm font-semibold rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
        </div>

      <% end %>
    </div>

  </div>
</div>