<div class="p-4 sm:ml-64">
  <div class="max-w-2xl mx-auto">
    <div class="bg-white dark:bg-gray-800 shadow-lg rounded-2xl overflow-hidden border border-gray-100 dark:border-gray-700">

      <!-- Header -->
      <div class="px-6 sm:px-10 pt-8 sm:pt-10 pb-6 border-b border-gray-100 dark:border-gray-700">
        <div class="flex items-center gap-3 mb-2">
          <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-indigo-100 dark:bg-indigo-500/20 flex items-center justify-center">
            <svg class="w-5 h-5 text-indigo-600 dark:text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 16.5V9.75m0 0l-3.75 3.75M12 9.75l3.75 3.75M6.75 19.5a4.5 4.5 0 01-1.41-8.775 5.25 5.25 0 0110.233-2.33 3 3 0 013.758 3.848A3.752 3.752 0 0118 19.5H6.75z" />
            </svg>
          </div>
          <h2 class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white">
            Upload Your Document
          </h2>
        </div>
        <p class="text-sm text-gray-600 dark:text-gray-400">
          Give your file a name and upload a spreadsheet. It'll be saved and available in your documents list.
        </p>
      </div>

      <!-- Form -->
      <div class="p-6 sm:p-10">
        <%= form_with model: @home, url: home_index_url, method: :post, local: true, data: { turbo: false }, html: { class: "space-y-6" } do |f| %>

          <!-- Document Name -->
          <div>
            <%= f.label :name, 'Document Name', class: "block text-sm font-medium text-gray-900 dark:text-gray-200 mb-2" %>
            <%= f.text_field :name,
                             class: "w-full rounded-lg border-gray-300 dark:border-gray-600 shadow-sm focus:border-indigo-500 focus:ring focus:ring-indigo-200 focus:ring-opacity-50 dark:bg-gray-900 dark:text-gray-100 placeholder-gray-400 text-base sm:text-sm py-2.5 px-3.5",
                             placeholder: 'e.g. Melpay Payments',
                             required: true %>
          </div>

          <!-- File Upload -->
          <div>
            <%= f.label :document, 'Upload File', class: "block text-sm font-medium text-gray-900 dark:text-gray-200 mb-2" %>

            <label for="home_document" class="group relative flex flex-col items-center justify-center w-full rounded-xl border-2 border-dashed border-gray-300 dark:border-gray-600 bg-gray-50 dark:bg-gray-900/40 px-6 py-8 sm:py-10 text-center cursor-pointer transition-colors hover:border-indigo-400 hover:bg-indigo-50/50 dark:hover:bg-indigo-500/10">
              <svg class="w-9 h-9 text-gray-400 group-hover:text-indigo-500 transition-colors mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 7.5m0 0L7.5 12M12 7.5v9" />
              </svg>
              <p class="text-sm font-medium text-gray-700 dark:text-gray-200">
                <span class="text-indigo-600 dark:text-indigo-400">Click to upload</span> or drag and drop
              </p>
              <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">.xlsx or .csv files only</p>
              <p id="home_document_filename" class="mt-3 text-xs font-medium text-indigo-600 dark:text-indigo-400 hidden"></p>

              <%= f.file_field :document,
                               id: "home_document",
                               class: "sr-only",
                               accept: ".xlsx,.csv",
                               onchange: "document.getElementById('home_document_filename').textContent = this.files[0]?.name || ''; document.getElementById('home_document_filename').classList.toggle('hidden', !this.files.length);" %>
            </label>
          </div>

          <!-- Submit Button -->
          <div class="pt-2">
            <%= f.submit 'Upload Document',
                         class: "w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 border border-transparent text-sm font-semibold rounded-lg shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 dark:focus:ring-offset-gray-800 transition-colors" %>
          </div>

        <% end %>
      </div>

    </div>
  </div>
</div>