<div class="max-w-6xl mx-auto px-4 py-6">
  <!-- Top bar -->
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-800 dark:text-gray-100">Manage Roles</h1>
    <%= link_to new_role_path,
      class: "inline-flex items-center px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg shadow hover:bg-blue-700 focus:outline-none" do %>
      <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
      </svg>
      New Role
    <% end %>
  </div>

  <!-- Roles table -->
  <div class="overflow-x-auto bg-white dark:bg-gray-800 rounded-lg shadow">
    <table class="min-w-full text-sm text-left text-gray-700 dark:text-gray-200">
      <thead class="bg-gray-100 dark:bg-gray-700 text-xs uppercase font-semibold">
        <tr>
          <th scope="col" class="px-6 py-3">Name</th>
          <th scope="col" class="px-6 py-3">Resource Type</th>
          <th scope="col" class="px-6 py-3">Resource ID</th>
          <th scope="col" class="px-6 py-3 text-right">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @roles.each do |role| %>
          <tr class="border-b dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600">
            <td class="px-6 py-4 font-medium"><%= role.name %></td>
            <td class="px-6 py-4"><%= role.resource_type %></td>
            <td class="px-6 py-4"><%= role.resource_id %></td>
            <td class="px-6 py-4 text-right space-x-2">
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
